<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Office Metadata Cleaner - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-3xl mx-auto py-10 px-4">
    <a href="/" class="text-blue-600 hover:underline text-sm">← Back to Tools</a>
    <h1 class="text-2xl font-bold mt-2 mb-1">Office Metadata Cleaner</h1>
    <p class="text-gray-500 text-sm mb-6">Remove author, company, and other metadata from Word, Excel, and PowerPoint files. All processing is done on the server and the file is deleted immediately after.</p>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">Upload file (.docx / .xlsx / .pptx)</label>
      <input type="file" id="fileInput" accept=".docx,.xlsx,.pptx" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
      <button id="parseBtn" class="mt-4 bg-blue-600 text-white px-5 py-2 rounded hover:bg-blue-700 disabled:opacity-50" disabled>Analyze Metadata</button>
    </div>

    <div id="result" class="hidden bg-white rounded-xl shadow p-6">
      <h2 class="font-semibold mb-1">Metadata Found</h2>
      <p class="text-xs text-gray-500 mb-4">Items in <span class="text-red-600 font-medium">red</span> are recommended to remove. Others are usually safe to keep.</p>
      <div id="metaList" class="space-y-2 mb-4 text-sm"></div>
      <div class="flex gap-3 flex-wrap">
        <button id="selectRecommended" class="text-sm text-red-600 hover:underline">Select recommended only</button>
        <button id="selectAll" class="text-sm text-blue-600 hover:underline">Select all</button>
        <button id="selectNone" class="text-sm text-gray-500 hover:underline">Clear selection</button>
      </div>
      <button id="cleanBtn" class="mt-4 bg-red-600 text-white px-5 py-2 rounded hover:bg-red-700">Remove Selected & Download</button>
    </div>

    <div id="status" class="mt-4 text-sm text-gray-500"></div>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput');
    const parseBtn = document.getElementById('parseBtn');
    const result = document.getElementById('result');
    const metaList = document.getElementById('metaList');
    const cleanBtn = document.getElementById('cleanBtn');
    const status = document.getElementById('status');

    // Recommended to remove
    const recommendedKeys = [
      'creator', 'lastmodifiedby', 'author', 'company', 'manager',
      'lastprinted', 'revision', 'totaltime', 'template',
      'hyperlinkbase', 'application', 'appversion'
    ];

    let currentFile = null;
    let metadata = [];

    fileInput.onchange = () => {
      parseBtn.disabled = !fileInput.files[0];
      result.classList.add('hidden');
      status.textContent = '';
    };

    parseBtn.onclick = async () => {
      currentFile = fileInput.files[0];
      if (!currentFile) return;
      parseBtn.disabled = true;
      status.textContent = 'Analyzing...';
      const fd = new FormData();
      fd.append('file', currentFile);
      try {
        const res = await fetch('/api/office-metadata/parse', { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed');
        metadata = data.metadata || [];
        renderMeta();
        result.classList.remove('hidden');
        status.textContent = metadata.length ? '' : 'No metadata found.';
      } catch (e) {
        status.textContent = 'Error: ' + e.message;
      }
      parseBtn.disabled = false;
    };

    function isRecommended(key) {
      const k = (key || '').toLowerCase();
      return recommendedKeys.some(r => k.includes(r));
    }

    function renderMeta() {
      metaList.innerHTML = metadata.map((m, i) => {
        const rec = isRecommended(m.key) || isRecommended(m.name);
        return `<label class="flex items-start gap-2 p-2 rounded ${rec ? 'bg-red-50' : 'hover:bg-gray-50'}">
          <input type="checkbox" data-key="${m.key}" class="mt-1" ${rec ? 'checked' : ''}>
          <span class="flex-1">
            <span class="${rec ? 'text-red-700 font-medium' : 'text-gray-800'}">${m.name}</span>
            <span class="text-gray-400 ml-2 text-xs">${m.value}</span>
            ${rec ? '<span class="ml-2 text-xs text-red-500">(recommended)</span>' : ''}
          </span>
        </label>`;
      }).join('');
    }

    document.getElementById('selectRecommended').onclick = () => {
      document.querySelectorAll('#metaList input').forEach(cb => {
        const key = cb.dataset.key;
        cb.checked = isRecommended(key);
      });
    };
    document.getElementById('selectAll').onclick = () => {
      document.querySelectorAll('#metaList input').forEach(cb => cb.checked = true);
    };
    document.getElementById('selectNone').onclick = () => {
      document.querySelectorAll('#metaList input').forEach(cb => cb.checked = false);
    };

    cleanBtn.onclick = async () => {
      if (!currentFile) return;
      const checked = [...document.querySelectorAll('#metaList input:checked')].map(cb => cb.dataset.key);
      if (!checked.length) return alert('Please select at least one item to remove.');

      const msg = 'After removing metadata, if you open the file in an office application and save it again, new metadata will be generated.\n\nIf you plan to send this file to someone, please do not edit or save it after cleaning.\n\nContinue?';
      if (!confirm(msg)) return;

      cleanBtn.disabled = true;
      status.textContent = 'Cleaning...';
      const fd = new FormData();
      fd.append('file', currentFile);
      fd.append('remove', JSON.stringify(checked));
      try {
        const res = await fetch('/api/office-metadata/clean', { method: 'POST', body: fd });
        if (!res.ok) throw new Error(await res.text());
        const blob = await res.blob();
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'clean-' + currentFile.name;
        a.click();
        status.textContent = 'Download started.';
      } catch (e) {
        status.textContent = 'Error: ' + e.message;
      }
      cleanBtn.disabled = false;
    };
  </script>
</body>
</html>
