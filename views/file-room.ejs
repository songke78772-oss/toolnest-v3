<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>File Transfer Room</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen p-4">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h1 class="text-xl font-bold">File Transfer Room</h1>
        <span class="text-sm text-gray-500" id="statusText">Connecting...</span>
      </div>

      <% if (isHost) { %>
        <div class="bg-gray-100 rounded-lg p-4 mb-4">
          <p class="text-sm text-gray-600 mb-2">Invite Link:</p>
          <div class="flex gap-2">
            <input type="text" id="inviteLink" readonly class="flex-1 border rounded px-3 py-2 text-sm" value="<%= inviteLink %>">
            <button onclick="copyLink()" class="bg-blue-600 text-white px-4 py-2 rounded text-sm">Copy</button>
          </div>
        </div>

        <div id="uploadSection" class="hidden">
          <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
            <p class="text-gray-500 mb-2">Select files to send</p>
            <label class="inline-block bg-blue-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-blue-700">
              Select Files
              <input type="file" id="fileInput" multiple class="hidden">
            </label>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-8">
          <p class="text-gray-600" id="guestStatus">Waiting for host...</p>
        </div>
      <% } %>

      <div id="fileList" class="space-y-2 mt-4"></div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <h2 class="font-bold mb-3">Participants (<span id="participantCount">1</span>)</h2>
      <div id="participants" class="text-sm text-gray-600"><%= isHost ? 'You (Host)' : 'You (Guest)' %></div>
    </div>
  </div>

  <script>
    const roomId = '<%= roomId %>';
    const isHost = <%= isHost ? 'true' : 'false' %>;
    const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${location.host}`);
    
    let pc = null;
    let dataChannel = null;
    let iceCandidates = [];
    let receivingFile = null;
    let receivedChunks = [];

    function copyLink() {
      document.getElementById('inviteLink').select();
      document.execCommand('copy');
      alert('Copied');
    }

    function log(msg) {
      console.log(msg);
      const el = document.getElementById('statusText');
      if (el) el.textContent = msg;
    }

    ws.onopen = () => {
      ws.send(JSON.stringify({ type: 'join', roomId }));
      log('Connected');
    };

    ws.onmessage = async (e) => {
      const data = JSON.parse(e.data);
      
      if (data.type === 'peer-joined' && isHost) {
        document.getElementById('uploadSection').classList.remove('hidden');
        log('Guest joined - Starting P2P...');
        await startAsHost();
      }

      if (data.type === 'signal') {
        await handleSignal(data.payload);
      }
    };

    async function startAsHost() {
      pc = new RTCPeerConnection({
        iceServers: [
          { urls: 'stun:stun.l.google.com:19302' },
          { urls: 'stun:stun1.l.google.com:19302' }
        ]
      });

      dataChannel = pc.createDataChannel('files', { ordered: true });
      setupDataChannel(dataChannel);

      pc.onicecandidate = (e) => {
        if (e.candidate) {
          ws.send(JSON.stringify({
            type: 'signal',
            roomId,
            payload: { candidate: e.candidate }
          }));
        }
      };

      pc.oniceconnectionstatechange = () => {
        log('ICE: ' + pc.iceConnectionState);
      };

      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      
      ws.send(JSON.stringify({
        type: 'signal',
        roomId,
        payload: { offer: pc.localDescription }
      }));
      
      log('Offer sent');
    }

    async function handleSignal(payload) {
      if (payload.offer && !isHost) {
        pc = new RTCPeerConnection({
          iceServers: [
            { urls: 'stun:stun.l.google.com:19302' },
            { urls: 'stun:stun1.l.google.com:19302' }
          ]
        });

        pc.ondatachannel = (e) => {
          dataChannel = e.channel;
          setupDataChannel(dataChannel);
        };

        pc.onicecandidate = (e) => {
          if (e.candidate) {
            ws.send(JSON.stringify({
              type: 'signal',
              roomId,
              payload: { candidate: e.candidate }
            }));
          }
        };

        pc.oniceconnectionstatechange = () => {
          log('ICE: ' + pc.iceConnectionState);
        };

        await pc.setRemoteDescription(new RTCSessionDescription(payload.offer));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        
        ws.send(JSON.stringify({
          type: 'signal',
          roomId,
          payload: { answer: pc.localDescription }
        }));
        
        log('Answer sent');
      }

      if (payload.answer && isHost && pc) {
        await pc.setRemoteDescription(new RTCSessionDescription(payload.answer));
        log('Answer received');
      }

      if (payload.candidate && pc) {
        try {
          await pc.addIceCandidate(new RTCIceCandidate(payload.candidate));
        } catch (err) {
          console.warn('ICE candidate error:', err);
        }
      }
    }

    function setupDataChannel(channel) {
      channel.binaryType = 'arraybuffer';
      
      channel.onopen = () => {
        log('P2P Ready');
        if (!isHost) {
          const el = document.getElementById('guestStatus');
          if (el) el.textContent = 'Connected. Waiting for files...';
        }
      };

      channel.onclose = () => log('Channel closed');
      channel.onerror = (e) => console.error('Channel error:', e);

      channel.onmessage = (e) => {
        if (typeof e.data === 'string') {
          const msg = JSON.parse(e.data);
          if (msg.type === 'file-meta') {
            receivingFile = { name: msg.name, size: msg.size, chunks: msg.chunks };
            receivedChunks = [];
            log('Receiving: ' + msg.name);
          }
        } else {
          receivedChunks.push(e.data);
          if (receivingFile && receivedChunks.length >= receivingFile.chunks) {
            const blob = new Blob(receivedChunks);
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = receivingFile.name;
            a.click();
            URL.revokeObjectURL(url);
            log('Done: ' + receivingFile.name);
            receivingFile = null;
            receivedChunks = [];
          }
        }
      };
    }

    if (isHost) {
      document.getElementById('fileInput').addEventListener('change', async (e) => {
        if (!dataChannel || dataChannel.readyState !== 'open') {
          alert('P2P not ready. Wait for "P2P Ready" status.');
          return;
        }

        for (const file of e.target.files) {
          await sendFile(file);
        }
        e.target.value = '';
      });
    }

    async function sendFile(file) {
      const chunkSize = 16384;
      const totalChunks = Math.ceil(file.size / chunkSize);
      
      const div = document.createElement('div');
      div.className = 'bg-gray-50 p-3 rounded text-sm';
      div.textContent = 'Sending: ' + file.name;
      document.getElementById('fileList').appendChild(div);

      dataChannel.send(JSON.stringify({
        type: 'file-meta',
        name: file.name,
        size: file.size,
        chunks: totalChunks
      }));

      for (let i = 0; i < totalChunks; i++) {
        const start = i * chunkSize;
        const end = Math.min(start + chunkSize, file.size);
        const buffer = await file.slice(start, end).arrayBuffer();
        
        while (dataChannel.bufferedAmount > 512 * 1024) {
          await new Promise(r => setTimeout(r, 10));
        }
        dataChannel.send(buffer);
      }

      div.textContent = 'Sent: ' + file.name;
    }
  </script>
</body>
</html>
