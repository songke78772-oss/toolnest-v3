<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure File Transfer Room</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen p-4">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h1 class="text-xl font-bold">File Transfer Room</h1>
        <span class="text-sm text-gray-500" id="statusText">Connecting...</span>
      </div>

      <% if (isHost) { %>
        <div class="bg-gray-100 rounded-lg p-4 mb-4">
          <p class="text-sm text-gray-600 mb-2">Invite Link:</p>
          <div class="flex gap-2">
            <input type="text" id="inviteLink" readonly class="flex-1 border rounded px-3 py-2 text-sm" value="<%= inviteLink %>">
            <button onclick="copyLink()" class="bg-blue-600 text-white px-4 py-2 rounded text-sm">Copy</button>
          </div>
        </div>

        <div id="uploadSection" class="hidden">
          <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
            <p class="text-gray-500 mb-2">Select files to send</p>
            <label class="inline-block bg-blue-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-blue-700">
              Select Files
              <input type="file" id="fileInput" multiple class="hidden">
            </label>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-8">
          <p class="text-gray-600 mb-4" id="guestStatus">Waiting for host...</p>
          <button id="startReceive" class="bg-green-600 text-white px-6 py-2 rounded hidden hover:bg-green-700">Start Receiving</button>
        </div>
      <% } %>

      <div id="fileList" class="space-y-2 mt-4"></div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <h2 class="font-bold mb-3">Participants (<span id="participantCount">1</span>)</h2>
      <div id="participants" class="text-sm text-gray-600"><%= isHost ? 'You (Host)' : 'You (Guest)' %></div>
    </div>
  </div>

  <script>
    const roomId = '<%= roomId %>';
    const isHost = <%= isHost ? 'true' : 'false' %>;
    const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${location.host}`);
    
    let pc = null;
    let dataChannel = null;
    let receivingFile = null;
    let receivedChunks = [];

    function copyLink() {
      const input = document.getElementById('inviteLink');
      input.select();
      document.execCommand('copy');
      alert('Copied');
    }

    function log(msg) {
      console.log(msg);
      const status = document.getElementById('statusText');
      if (status) status.textContent = msg;
    }

    ws.onopen = () => {
      ws.send(JSON.stringify({ type: 'join', roomId }));
      log('Connected');
    };

    ws.onmessage = async (event) => {
      const data = JSON.parse(event.data);
      
      if (data.type === 'peer-joined' && isHost) {
        document.getElementById('uploadSection').classList.remove('hidden');
        log('Guest joined - Establishing connection...');
        await createPeerConnection();
      }

      if (data.type === 'signal') {
        await handleSignal(data.payload);
      }
    };

    async function createPeerConnection() {
      if (pc) return;
      
      pc = new RTCPeerConnection({ 
        iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] 
      });

      if (isHost) {
        dataChannel = pc.createDataChannel('fileTransfer');
        setupDataChannel(dataChannel);
      } else {
        pc.ondatachannel = (e) => {
          dataChannel = e.channel;
          setupDataChannel(dataChannel);
        };
      }

      pc.onicecandidate = (e) => {
        if (e.candidate) {
          ws.send(JSON.stringify({ 
            type: 'signal', 
            roomId, 
            payload: { candidate: e.candidate } 
          }));
        }
      };

      if (isHost) {
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        ws.send(JSON.stringify({ 
          type: 'signal', 
          roomId, 
          payload: { offer } 
        }));
        log('Waiting for guest to accept...');
      }
    }

    async function handleSignal(payload) {
      if (!pc && !isHost) {
        await createPeerConnection();
      }
      if (!pc) return;

      try {
        if (payload.offer) {
          await pc.setRemoteDescription(new RTCSessionDescription(payload.offer));
          const answer = await pc.createAnswer();
          await pc.setLocalDescription(answer);
          ws.send(JSON.stringify({ 
            type: 'signal', 
            roomId, 
            payload: { answer } 
          }));
          log('Connection accepted');
        }

        if (payload.answer) {
          await pc.setRemoteDescription(new RTCSessionDescription(payload.answer));
          log('Peer connected');
        }

        if (payload.candidate) {
          await pc.addIceCandidate(new RTCIceCandidate(payload.candidate));
        }
      } catch (err) {
        console.error('Signal error:', err);
        log('Connection error');
      }
    }

    function setupDataChannel(channel) {
      channel.binaryType = 'arraybuffer';
      
      channel.onopen = () => {
        log('P2P Connected - Ready');
        if (!isHost) {
          const btn = document.getElementById('startReceive');
          if (btn) btn.classList.remove('hidden');
          const guestStatus = document.getElementById('guestStatus');
          if (guestStatus) guestStatus.textContent = 'Connected. Waiting for file...';
        }
      };

      channel.onmessage = (e) => {
        if (typeof e.data === 'string') {
          const msg = JSON.parse(e.data);
          if (msg.type === 'file-meta') {
            receivingFile = msg;
            receivedChunks = [];
            log(`Receiving: ${msg.name}`);
          }
        } else {
          receivedChunks.push(e.data);
          if (receivingFile && receivedChunks.length >= receivingFile.chunks) {
            const blob = new Blob(receivedChunks);
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = receivingFile.name;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            log('File received');
            receivingFile = null;
            receivedChunks = [];
          }
        }
      };

      channel.onerror = (err) => {
        console.error('DataChannel error:', err);
        log('Transfer error');
      };
    }

    if (isHost) {
      const fileInput = document.getElementById('fileInput');
      if (fileInput) {
        fileInput.addEventListener('change', async (e) => {
          const files = Array.from(e.target.files);
          if (files.length === 0) return;

          // 等待 DataChannel 打开
          if (!dataChannel || dataChannel.readyState !== 'open') {
            log('Waiting for connection...');
            await new Promise(resolve => {
              const check = setInterval(() => {
                if (dataChannel && dataChannel.readyState === 'open') {
                  clearInterval(check);
                  resolve();
                }
              }, 300);
              setTimeout(() => {
                clearInterval(check);
                resolve();
              }, 15000);
            });
          }

          if (!dataChannel || dataChannel.readyState !== 'open') {
            alert('Connection not ready. Please refresh both pages and try again.');
            return;
          }
          
          for (const file of files) {
            await sendFile(file);
          }
          fileInput.value = '';
        });
      }
    }

    async function sendFile(file) {
      const chunkSize = 16384;
      const chunks = Math.ceil(file.size / chunkSize);
      
      const list = document.getElementById('fileList');
      const div = document.createElement('div');
      div.className = 'bg-gray-50 p-3 rounded text-sm';
      div.textContent = `Sending: ${file.name}...`;
      list.appendChild(div);

      dataChannel.send(JSON.stringify({
        type: 'file-meta',
        name: file.name,
        size: file.size,
        chunks: chunks
      }));

      for (let i = 0; i < chunks; i++) {
        const start = i * chunkSize;
        const end = Math.min(start + chunkSize, file.size);
        const chunk = file.slice(start, end);
        const buffer = await chunk.arrayBuffer();
        
        // 等待 buffer 有空间
        while (dataChannel.bufferedAmount > 1024 * 1024) {
          await new Promise(r => setTimeout(r, 50));
        }
        
        dataChannel.send(buffer);
      }
      
      div.textContent = `Sent: ${file.name}`;
      log('File sent');
    }

    if (!isHost) {
      const btn = document.getElementById('startReceive');
      if (btn) {
        btn.addEventListener('click', () => {
          const guestStatus = document.getElementById('guestStatus');
          if (guestStatus) guestStatus.textContent = 'Ready to receive files';
          btn.classList.add('hidden');
        });
      }
    }
  </script>
</body>
</html>
