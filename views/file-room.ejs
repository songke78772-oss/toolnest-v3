<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure File Transfer Room</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen p-4">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h1 class="text-xl font-bold">File Transfer Room</h1>
        <span class="text-sm text-gray-500" id="statusText">Connecting...</span>
      </div>

      <% if (isHost) { %>
        <div class="bg-gray-100 rounded-lg p-4 mb-4">
          <p class="text-sm text-gray-600 mb-2">Invite Link:</p>
          <div class="flex gap-2">
            <input type="text" id="inviteLink" readonly class="flex-1 border rounded px-3 py-2 text-sm" value="<%= inviteLink %>">
            <button onclick="copyLink()" class="bg-blue-600 text-white px-4 py-2 rounded text-sm">Copy</button>
          </div>
        </div>

        <div id="uploadSection" class="hidden">
          <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
            <p class="text-gray-500 mb-2">Select files to send</p>
            <label class="inline-block bg-blue-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-blue-700">
              Select Files
              <input type="file" id="fileInput" multiple class="hidden">
            </label>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-8">
          <p class="text-gray-600 mb-4" id="guestStatus">Waiting for host...</p>
          <button id="startReceive" class="bg-green-600 text-white px-6 py-2 rounded hidden hover:bg-green-700">Start Receiving</button>
        </div>
      <% } %>

      <div id="fileList" class="space-y-2 mt-4"></div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <h2 class="font-bold mb-3">Participants (<span id="participantCount">1</span>)</h2>
      <div id="participants" class="text-sm text-gray-600"><%= isHost ? 'You (Host)' : 'You (Guest)' %></div>
    </div>
  </div>

  <script>
    const roomId = '<%= roomId %>';
    const isHost = <%= isHost ? 'true' : 'false' %>;
    const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${location.host}`);
    
    let pc = null;
    let dataChannel = null;

    function copyLink() {
      document.getElementById('inviteLink').select();
      document.execCommand('copy');
      alert('Copied');
    }

    ws.onopen = () => {
      ws.send(JSON.stringify({ type: 'join', roomId }));
      document.getElementById('statusText').textContent = 'Connected';
    };

    ws.onmessage = async (event) => {
      const data = JSON.parse(event.data);
      
      if (data.type === 'peer-joined' && isHost) {
        document.getElementById('uploadSection').classList.remove('hidden');
        document.getElementById('statusText').textContent = 'Guest joined - Ready to send';
      }

      if (data.type === 'signal') {
        await handleSignal(data.payload);
      }
    };

    async function createPeer() {
      pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });
      
      if (isHost) {
        dataChannel = pc.createDataChannel('file');
        setupDataChannel(dataChannel);
      } else {
        pc.ondatachannel = (e) => {
          dataChannel = e.channel;
          setupDataChannel(dataChannel);
        };
      }

      pc.onicecandidate = (e) => {
        if (e.candidate) {
          ws.send(JSON.stringify({ type: 'signal', roomId, payload: { candidate: e.candidate } }));
        }
      };

      if (isHost) {
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        ws.send(JSON.stringify({ type: 'signal', roomId, payload: { offer } }));
      }
    }

    async function handleSignal(payload) {
      if (!pc) await createPeer();

      if (payload.offer) {
        await pc.setRemoteDescription(payload.offer);
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        ws.send(JSON.stringify({ type: 'signal', roomId, payload: { answer } }));
      }

      if (payload.answer) {
        await pc.setRemoteDescription(payload.answer);
      }

      if (payload.candidate) {
        await pc.addIceCandidate(payload.candidate);
      }
    }

    function setupDataChannel(channel) {
      channel.onopen = () => {
        document.getElementById('statusText').textContent = 'Connected - Ready';
        if (!isHost) {
          document.getElementById('startReceive').classList.remove('hidden');
        }
      };

      channel.onmessage = (e) => {
        if (typeof e.data === 'string') {
          const meta = JSON.parse(e.data);
          if (meta.type === 'file-meta') {
            receiveFile(meta);
          }
        } else {
          appendChunk(e.data);
        }
      };
    }

    let receivedChunks = [];
    let fileMeta = null;

    function receiveFile(meta) {
      fileMeta = meta;
      receivedChunks = [];
      document.getElementById('guestStatus').textContent = `Receiving: ${meta.name}`;
    }

    function appendChunk(chunk) {
      receivedChunks.push(chunk);
      if (receivedChunks.length === fileMeta.chunks) {
        const blob = new Blob(receivedChunks);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileMeta.name;
        a.click();
        document.getElementById('guestStatus').textContent = 'File received';
      }
    }

    if (isHost) {
      document.getElementById('fileInput')?.addEventListener('change', async (e) => {
        if (!pc) await createPeer();
        for (const file of e.target.files) {
          await sendFile(file);
        }
      });
    }

    async function sendFile(file) {
      const chunkSize = 16384;
      const chunks = Math.ceil(file.size / chunkSize);
      
      dataChannel.send(JSON.stringify({ type: 'file-meta', name: file.name, size: file.size, chunks }));

      for (let i = 0; i < chunks; i++) {
        const chunk = file.slice(i * chunkSize, (i + 1) * chunkSize);
        dataChannel.send(await chunk.arrayBuffer());
        await new Promise(r => setTimeout(r, 10));
      }
    }

    if (!isHost) {
      document.getElementById('startReceive').addEventListener('click', () => {
        document.getElementById('guestStatus').textContent = 'Waiting for file...';
        document.getElementById('startReceive').classList.add('hidden');
      });
    }
  </script>
</body>
</html>
