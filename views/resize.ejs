<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resize Image - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>

  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Resize Image</h1>
      <p class="text-gray-600 mt-2">Change image dimensions. All processing happens in your browser.</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div id="uploadArea" class="border-2 border-dashed border-gray-300 rounded-lg p-10 text-center cursor-pointer hover:border-blue-500 transition">
        <div class="text-5xl mb-3">📐</div>
        <p class="text-lg font-medium text-gray-700">Click or drag image here</p>
        <p class="text-sm text-gray-500 mt-1">Supports JPG, PNG, WebP</p>
        <input type="file" id="fileInput" accept="image/*" class="hidden">
      </div>

      <div id="controls" class="hidden mt-6 space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Width (px)</label>
            <input type="number" id="width" class="w-full border rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Height (px)</label>
            <input type="number" id="height" class="w-full border rounded-lg px-3 py-2">
          </div>
        </div>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" id="keepRatio" checked> Keep aspect ratio
        </label>
        <div class="flex gap-3">
          <button id="resizeBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-medium">Resize Image</button>
          <button id="downloadBtn" class="hidden bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg font-medium">Download</button>
          <button id="resetBtn" class="text-gray-600 hover:text-gray-800 px-4 py-2.5">Reset</button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          <div>
            <p class="text-sm font-medium text-gray-700 mb-2">Original</p>
            <img id="originalPreview" class="max-w-full rounded border">
            <p id="originalInfo" class="text-xs text-gray-500 mt-1"></p>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-700 mb-2">Resized</p>
            <img id="resizedPreview" class="max-w-full rounded border">
            <p id="resizedInfo" class="text-xs text-gray-500 mt-1"></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const widthInput = document.getElementById('width');
    const heightInput = document.getElementById('height');
    const keepRatio = document.getElementById('keepRatio');
    const resizeBtn = document.getElementById('resizeBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const resetBtn = document.getElementById('resetBtn');
    const originalPreview = document.getElementById('originalPreview');
    const resizedPreview = document.getElementById('resizedPreview');
    const originalInfo = document.getElementById('originalInfo');
    const resizedInfo = document.getElementById('resizedInfo');

    let originalFile = null, resizedBlob = null, originalWidth = 0, originalHeight = 0, aspectRatio = 1;

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.classList.add('border-blue-500'); });
    uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('border-blue-500'));
    uploadArea.addEventListener('drop', e => {
      e.preventDefault(); uploadArea.classList.remove('border-blue-500');
      if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', e => { if (e.target.files[0]) handleFile(e.target.files[0]); });

    function handleFile(file) {
      if (!file.type.startsWith('image/')) return alert('Please select an image');
      originalFile = file;
      const url = URL.createObjectURL(file);
      originalPreview.src = url;
      const img = new Image();
      img.onload = () => {
        originalWidth = img.width; originalHeight = img.height; aspectRatio = originalWidth / originalHeight;
        widthInput.value = originalWidth; heightInput.value = originalHeight;
        originalInfo.textContent = `${originalWidth} × ${originalHeight} px · ${(file.size / 1024).toFixed(1)} KB`;
        controls.classList.remove('hidden'); downloadBtn.classList.add('hidden');
        resizedPreview.src = ''; resizedInfo.textContent = '';
      };
      img.src = url;
    }

    widthInput.addEventListener('input', () => { if (keepRatio.checked && widthInput.value) heightInput.value = Math.round(widthInput.value / aspectRatio); });
    heightInput.addEventListener('input', () => { if (keepRatio.checked && heightInput.value) widthInput.value = Math.round(heightInput.value * aspectRatio); });

    resizeBtn.addEventListener('click', () => {
      if (!originalFile) return;
      const w = parseInt(widthInput.value), h = parseInt(heightInput.value);
      if (!w || !h || w < 1 || h < 1) return alert('Invalid dimensions');
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const img = new Image();
      img.onload = () => {
        canvas.width = w; canvas.height = h;
        ctx.drawImage(img, 0, 0, w, h);
        canvas.toBlob(blob => {
          resizedBlob = blob;
          resizedPreview.src = URL.createObjectURL(blob);
          resizedInfo.textContent = `${w} × ${h} px · ${(blob.size / 1024).toFixed(1)} KB`;
          downloadBtn.classList.remove('hidden');
        }, originalFile.type || 'image/jpeg', 0.92);
      };
      img.src = URL.createObjectURL(originalFile);
    });

    downloadBtn.addEventListener('click', () => {
      if (!resizedBlob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(resizedBlob);
      a.download = 'resized_' + (originalFile.name.replace(/\.[^/.]+$/, '') || 'image') + '.' + (originalFile.name.split('.').pop() || 'jpg');
      a.click();
    });

    resetBtn.addEventListener('click', () => { controls.classList.add('hidden'); fileInput.value = ''; originalFile = null; resizedBlob = null; });
  </script>
</body>
</html>
