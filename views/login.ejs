<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen">
  <div class="bg-white rounded-lg shadow p-8 w-full max-w-md">
    <h1 class="text-2xl font-bold text-center mb-6">Login to ToolNest</h1>
    <% if (typeof verified !== 'undefined' && verified) { %>
      <p class="text-green-600 text-center mb-4">Email verified! Please login.</p>
    <% } %>
    <% if (error) { %><p class="text-red-600 text-center mb-4"><%= error %></p><% } %>
    <form action="/login" method="POST" class="space-y-4">
      <input type="email" name="email" required placeholder="Email" class="w-full border rounded p-3">
      <input type="password" name="password" required placeholder="Password" class="w-full border rounded p-3">
      <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded">Login</button>
    </form>
    <p class="text-center mt-4 text-sm">No account? <a href="/register" class="text-blue-600">Register</a></p>
  </div>
</body>
</html>
