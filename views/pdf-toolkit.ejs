<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PDF Toolkit - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-xl font-bold text-gray-800">ToolNest</a>
    <a href="/dashboard" class="text-sm text-gray-600 hover:text-gray-900">返回控制台</a>
