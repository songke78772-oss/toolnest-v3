<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Remove Duplicate Lines - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Remove Duplicate Lines</h1>
    <p class="text-gray-600 mb-6">Remove duplicate lines from text.</p>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="input" rows="10" class="w-full border rounded-lg p-4" placeholder="Paste text with duplicates..."></textarea>
      <button id="process" class="bg-blue-600 text-white px-6 py-2 rounded-lg">Remove Duplicates</button>
      <textarea id="output" rows="10" class="w-full border rounded-lg p-4 bg-gray-50" readonly></textarea>
    </div>
  </div>
  <script>
    document.getElementById('process').onclick = () => {
      const lines = document.getElementById('input').value.split('\n');
      const unique = [...new Set(lines)];
      document.getElementById('output').value = unique.join('\n');
    };
  </script>
</body>
</html>
