<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PDF Tools - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      overflow: hidden;
    }
    .pdf-frame-wrapper {
      width: 100%;
      height: calc(100vh - 64px); /* 减去顶部导航高度 */
      position: relative;
      overflow: hidden;
    }
    .pdf-frame-wrapper iframe {
      width: 100%;
      height: calc(100% + 70px);   /* 多出的高度用来藏掉 BentoPDF 头部 */
      border: none;
      margin-top: -70px;           /* 往上移，藏住头部 */
    }
  </style>

  <meta name="description" content="Compress, merge, and split PDF files online. Free PDF toolkit.">
  <link rel="canonical" href="https://protoolnest.com/pdf-tools"></head>
<body class="bg-gray-100">
  <!-- ProToolNest 顶部导航 -->
  <nav class="bg-white border-b h-16 flex items-center">
    <div class="max-w-7xl mx-auto px-4 w-full flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← 返回工具列表</a>
    </div>
  </nav>

  <!-- BentoPDF iframe -->
  <div class="pdf-frame-wrapper">
    <iframe 
      src="http://192.255.128.40:8081"
      allowfullscreen
      title="PDF Tools">
    </iframe>
  </div>
</body>
</html>
