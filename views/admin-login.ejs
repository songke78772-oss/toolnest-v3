<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
  <div class="bg-white p-8 rounded-xl shadow w-full max-w-sm">
    <h1 class="text-xl font-bold text-center mb-6">Admin Login</h1>
    <% if (error) { %><p class="text-red-500 text-sm text-center mb-4"><%= error %></p><% } %>
    <form action="/admin/login" method="post">
      <input type="password" name="password" required placeholder="Password" class="w-full border rounded-lg px-4 py-3 mb-4">
      <button type="submit" class="w-full bg-gray-800 text-white py-3 rounded-lg">Login</button>
    </form>
  </div>
</body>
</html>
