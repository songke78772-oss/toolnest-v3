<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Remove Background - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Remove Background (Color)</h1>
      <p class="text-gray-600 mt-2">Simple color-based background removal. All processing happens in your browser.</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div id="uploadArea" class="border-2 border-dashed border-gray-300 rounded-lg p-10 text-center cursor-pointer hover:border-blue-500 transition">
        <div class="text-5xl mb-3">✂️</div>
        <p class="text-lg font-medium text-gray-700">Click or drag image here</p>
        <input type="file" id="fileInput" accept="image/*" class="hidden">
      </div>
      <div id="controls" class="hidden mt-6 space-y-4">
        <div class="flex items-center gap-4">
          <label class="text-sm">Background Color:</label>
          <input type="color" id="bgColor" value="#ffffff">
          <label class="text-sm">Tolerance: <span id="tolVal">30</span></label>
          <input type="range" id="tolerance" min="0" max="100" value="30" class="flex-1">
        </div>
        <button id="applyBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg">Remove Background</button>
        <img id="result" class="max-w-full rounded border mt-4 hidden">
        <button id="downloadBtn" class="hidden bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg">Download PNG</button>
        <button id="resetBtn" class="ml-3 text-gray-600 px-4 py-2.5">Reset</button>
      </div>
    </div>
  </div>
  <script>
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const bgColor = document.getElementById('bgColor');
    const tolerance = document.getElementById('tolerance');
    const tolVal = document.getElementById('tolVal');
    const applyBtn = document.getElementById('applyBtn');
    const result = document.getElementById('result');
    const downloadBtn = document.getElementById('downloadBtn');
    const resetBtn = document.getElementById('resetBtn');
    let originalFile, resultBlob, originalName = 'image';

    tolerance.addEventListener('input', () => tolVal.textContent = tolerance.value);

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('drop', e => { e.preventDefault(); if (e.dataTransfer.files[0]) load(e.dataTransfer.files[0]); });
    uploadArea.addEventListener('dragover', e => e.preventDefault());
    fileInput.addEventListener('change', e => { if (e.target.files[0]) load(e.target.files[0]); });

    function load(file) {
      originalFile = file;
      originalName = file.name.replace(/\.[^/.]+$/, '');
      controls.classList.remove('hidden');
    }

    function hexToRgb(hex) {
      const r = parseInt(hex.slice(1,3),16);
      const g = parseInt(hex.slice(3,5),16);
      const b = parseInt(hex.slice(5,7),16);
      return {r,g,b};
    }

    applyBtn.addEventListener('click', () => {
      if (!originalFile) return;
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.width; canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imageData.data;
        const target = hexToRgb(bgColor.value);
        const tol = parseInt(tolerance.value) * 2.55;
        for (let i = 0; i < data.length; i += 4) {
          const dr = Math.abs(data[i] - target.r);
          const dg = Math.abs(data[i+1] - target.g);
          const db = Math.abs(data[i+2] - target.b);
          if (dr < tol && dg < tol && db < tol) {
            data[i+3] = 0;
          }
        }
        ctx.putImageData(imageData, 0, 0);
        canvas.toBlob(blob => {
          resultBlob = blob;
          result.src = URL.createObjectURL(blob);
          result.classList.remove('hidden');
          downloadBtn.classList.remove('hidden');
        }, 'image/png');
      };
      img.src = URL.createObjectURL(originalFile);
    });

    downloadBtn.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(resultBlob);
      a.download = 'nobg_' + originalName + '.png';
      a.click();
    });

    resetBtn.addEventListener('click', () => { controls.classList.add('hidden'); fileInput.value = ''; });
  </script>
</body>
</html>
