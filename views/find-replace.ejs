<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Find and Replace - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Find and replace text in bulk online.">
  <link rel="canonical" href="https://protoolnest.com/find-replace"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Find & Replace</h1>
    <p class="text-gray-600 mb-6">Find and replace text.</p>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="text" rows="8" class="w-full border rounded-lg p-4" placeholder="Original text..."></textarea>
      <div class="grid grid-cols-2 gap-4">
        <input id="find" class="border rounded-lg px-4 py-2" placeholder="Find">
        <input id="replace" class="border rounded-lg px-4 py-2" placeholder="Replace with">
      </div>
      <label class="text-sm"><input type="checkbox" id="case"> Case sensitive</label>
      <button id="do" class="bg-blue-600 text-white px-6 py-2 rounded-lg">Replace</button>
      <textarea id="output" rows="8" class="w-full border rounded-lg p-4 bg-gray-50" readonly></textarea>
    </div>
  </div>
  <script>
    document.getElementById('do').onclick = () => {
      let text = document.getElementById('text').value;
      const find = document.getElementById('find').value;
      const replace = document.getElementById('replace').value;
      const sensitive = document.getElementById('case').checked;
      const flags = sensitive ? 'g' : 'gi';
      text = text.replace(new RegExp(find.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), flags), replace);
      document.getElementById('output').value = text;
    };
  </script>
</body>
</html>
