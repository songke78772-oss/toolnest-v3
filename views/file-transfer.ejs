<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure File Transfer</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <!-- Create Room Card -->
    <div class="bg-white rounded-xl shadow-lg p-8 mb-6">
      <h1 class="text-2xl font-bold text-center mb-8">Create Secure File Transfer</h1>

      <form action="/file-transfer/create" method="POST" class="space-y-6">
        <!-- Max Participants -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Max Participants (including you)</label>
          <select name="maxParticipants" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value="2">2 people</option>
            <option value="3">3 people</option>
            <option value="5" selected>5 people</option>
            <option value="10">10 people</option>
          </select>
        </div>

        <!-- Duration -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Duration</label>
          <select name="duration" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value="1">1 hour</option>
            <option value="2" selected>2 hours</option>
            <option value="6">6 hours</option>
            <option value="24">24 hours</option>
          </select>
        </div>

        <!-- Deep Encryption -->
        <div class="flex items-center">
          <input type="checkbox" name="encryption" id="encryption" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
          <label for="encryption" class="ml-2 text-sm text-gray-700">Enable Deep Encryption (password required)</label>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg font-medium hover:bg-blue-700 transition">
          Create Room
        </button>
      </form>
    </div>

    <!-- How to Use -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <div class="border-b mb-4">
          <span class="text-blue-600 font-medium border-b-2 border-blue-600 pb-2">How to Use</span>
        </div>
        <div class="space-y-4 text-sm text-gray-600">
          <div>
            <strong class="text-gray-900">1. Set room options</strong><br>
            Choose how many people can join and how long the room lasts.
          </div>
          <div>
            <strong class="text-gray-900">2. Create the room</strong><br>
            Click Create Room. You'll get one-time invite links. Share them only with people you want to join.
          </div>
          <div>
            <strong class="text-gray-900">3. Transfer files</strong><br>
            Everyone joins with a link. Files are transferred directly between browsers (P2P). Nothing is stored on the server.
          </div>
          <div>
            <strong class="text-gray-900">4. Optional encryption</strong><br>
            Enable Deep Encryption and set a short password. Only people who know the password can join and transfer files.
          </div>
          <div class="text-red-600">
            <strong class="text-red-700">5. Network issues</strong><br>
            In some network conditions, connection may fail. Please turn off proxy/VPN, and avoid using it in local network (LAN) environments.
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
