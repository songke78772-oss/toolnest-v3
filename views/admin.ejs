<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<nav class="bg-gray-800 text-white px-4 py-3">
  <div class="max-w-6xl mx-auto flex justify-between">
    <span class="font-bold">ToolNest Admin</span>
    <a href="/admin/logout" class="text-sm">Logout</a>
  </div>
</nav>

<div class="max-w-6xl mx-auto px-4 py-6">
  <h2 class="text-lg font-bold mb-4">Add New Tool</h2>
  <form action="/admin/add-tool" method="post" class="bg-white p-4 rounded-lg mb-8 grid grid-cols-2 md:grid-cols-6 gap-3">
    <input name="name" required placeholder="Name" class="border rounded px-3 py-2">
    <input name="icon" placeholder="Icon" class="border rounded px-3 py-2">
    <input name="category" placeholder="Category" class="border rounded px-3 py-2">
    <input name="url" required placeholder="URL" class="border rounded px-3 py-2 col-span-2">
    <button type="submit" class="bg-blue-600 text-white rounded px-4 py-2">Add</button>
    <textarea name="description" placeholder="Description" class="border rounded px-3 py-2 col-span-2 md:col-span-6" rows="2"></textarea>
  </form>

  <h2 class="text-lg font-bold mb-4">Tools (<%= tools.length %>)</h2>
  <div class="bg-white rounded-lg overflow-hidden mb-8">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="text-left p-3">Tool</th>
          <th class="text-left p-3">Category</th>
          <th class="text-left p-3">URL</th>
          <th class="text-left p-3">Usage</th>
          <th class="text-left p-3">Status</th>
          <th class="text-left p-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% tools.forEach(t => { %>
          <tr class="border-t">
            <td class="p-3"><%= t.icon %> <%= t.name %></td>
            <td class="p-3"><%= t.category %></td>
            <td class="p-3 text-xs text-gray-500"><%= t.url %></td>
            <td class="p-3"><%= t.usage_count || 0 %></td>
            <td class="p-3"><%= t.is_active ? 'Active' : 'Hidden' %></td>
            <td class="p-3">
              <form action="/admin/toggle/<%= t.id %>" method="post" class="inline">
                <button class="text-blue-600 text-xs">Toggle</button>
              </form>
              <form action="/admin/delete/<%= t.id %>" method="post" class="inline ml-2">
                <button class="text-red-600 text-xs" onclick="return confirm('Delete?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <h2 class="text-lg font-bold mb-4">Users (<%= users.length %>)</h2>
  <div class="bg-white rounded-lg overflow-hidden mb-8">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="text-left p-3">ID</th>
          <th class="text-left p-3">Email</th>
          <th class="text-left p-3">Verified</th>
          <th class="text-left p-3">Created</th>
          <th class="text-left p-3">Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr class="border-t">
            <td class="p-3"><%= u.id %></td>
            <td class="p-3"><%= u.email %></td>
            <td class="p-3"><%= u.verified ? 'Yes' : 'No' %></td>
            <td class="p-3 text-xs"><%= u.created_at %></td>
            <td class="p-3">
              <form action="/admin/delete-user/<%= u.id %>" method="post" class="inline">
                <button class="text-red-600 text-xs" onclick="return confirm('Delete user?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <h2 class="text-lg font-bold mb-4">Tool Requests</h2>
  <div class="bg-white rounded-lg p-4">
    <% if (requests.length === 0) { %>
      <p class="text-gray-500">No requests.</p>
    <% } else { %>
      <% requests.forEach(r => { %>
        <div class="border-b py-2">
          <div class="text-sm text-gray-500"><%= r.email %> · <%= r.created_at %></div>
          <div><%= r.description %></div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
</body>
</html>
