<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <title>Admin - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-5xl mx-auto py-8 px-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Admin</h1>
      <a href="/logout" class="text-sm text-gray-500">Logout</a>
    </div>

    <div class="bg-white rounded-lg p-6 mb-8">
      <h2 class="font-bold mb-4">Add Tool</h2>
      <form action="/admin/add-tool" method="post" class="space-y-3">
        <input name="name" placeholder="Name" class="w-full border rounded px-3 py-2" required>
        <input name="description" placeholder="Description" class="w-full border rounded px-3 py-2">
        <input name="category" placeholder="Category" class="w-full border rounded px-3 py-2" value="办公">
        <input name="url" placeholder="URL" class="w-full border rounded px-3 py-2">
        <button class="bg-blue-600 text-white px-4 py-2 rounded">Add</button>
      </form>
    </div>

    <h2 class="font-bold mb-3">Tools (<%= tools.length %>)</h2>
    <div class="bg-white rounded-lg overflow-hidden mb-8">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="text-left p-3">Name</th>
            <th class="text-left p-3">Category</th>
            <th class="text-left p-3">URL</th>
          </tr>
        </thead>
        <tbody>
          <% tools.forEach(t => { %>
            <tr class="border-t">
              <td class="p-3"><%= t.name %></td>
              <td class="p-3"><%= t.category %></td>
              <td class="p-3"><%= t.url %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <h2 class="font-bold mb-3">Users (<%= users.length %>)</h2>
    <div class="bg-white rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="text-left p-3">Email</th>
            <th class="text-left p-3">Status</th>
            <th class="text-left p-3">Created</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr class="border-t">
              <td class="p-3"><%= u.email %></td>
              <td class="p-3"><%= u.subscription_status %></td>
              <td class="p-3"><%= u.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
