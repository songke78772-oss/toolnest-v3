<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="canonical" href="https://protoolnest.com/admin">
</head>
<body class="bg-gray-100">
  <div class="max-w-5xl mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Admin Dashboard</h1>
      <a href="/logout" class="text-sm text-gray-600">Logout</a>
    </div>

    <!-- Add Tool -->
    <div class="bg-white p-6 rounded-lg shadow mb-8">
      <h2 class="text-lg font-semibold mb-4">Add Tool</h2>
      <form method="POST" action="/admin/add-tool" class="space-y-3">
        <input name="name" placeholder="Tool Name" class="w-full border p-2 rounded" required>
        <input name="description" placeholder="Description" class="w-full border p-2 rounded">
        <input name="category" placeholder="Category (e.g. audio, image, office)" class="w-full border p-2 rounded">
        <input name="url" placeholder="Tool URL (e.g. /audio-converter)" class="w-full border p-2 rounded">
        <input name="icon" placeholder="Icon (emoji, e.g. 🎵)" class="w-full border p-2 rounded">
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Add Tool</button>
      </form>
    </div>

    <!-- Tools List -->
    <div class="bg-white p-6 rounded-lg shadow mb-8">
      <h2 class="text-lg font-semibold mb-4">Tools</h2>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b">
            <th class="py-2">ID</th>
            <th>Icon</th>
            <th>Name</th>
            <th>Category</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% tools.forEach(tool => { %>
            <tr class="border-b">
              <td class="py-2"><%= tool.id %></td>
              <td class="text-xl"><%= tool.icon || '🔧' %></td>
              <td><%= tool.name %></td>
              <td><%= tool.category || '-' %></td>
              <td>
                <form method="POST" action="/admin/delete-tool/<%= tool.id %>" onsubmit="return confirm('Delete this tool?')">
                  <button class="text-red-600 text-xs">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Users List -->
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-4">Users</h2>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b">
            <th class="py-2">ID</th>
            <th>Email</th>
            <th>Created</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr class="border-b">
              <td class="py-2"><%= user.id %></td>
              <td><%= user.email %></td>
              <td><%= user.created_at %></td>
              <td>
                <form method="POST" action="/admin/delete-user/<%= user.id %>" onsubmit="return confirm('Delete this user?')">
                  <button class="text-red-600 text-xs">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
