<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EmberLink - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <meta name="description" content="Share a secret that can only be viewed once. Encrypted and auto-destroyed.">
  <link rel="canonical" href="https://protoolnest.com/one-time-secret">
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-2xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">EmberLink</h1>
    <p class="text-gray-600 mb-6">Share a message that can only be viewed once. Encrypted in your browser. Auto-destroyed after reading.</p>

    <div id="createSection" class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="secret" rows="6" class="w-full border rounded-lg p-4" placeholder="Enter your secret message..."></textarea>
      <div class="flex items-center gap-4">
        <label class="text-sm text-gray-600">Expires in:</label>
        <select id="ttl" class="border rounded px-3 py-1.5 text-sm">
          <option value="3600">1 hour</option>
          <option value="86400" selected>24 hours</option>
          <option value="604800">7 days</option>
        </select>
      </div>
      <button id="createBtn" class="bg-emerald-600 text-white px-6 py-2 rounded-lg hover:bg-emerald-700">Create Secret Link</button>
      <div id="result" class="hidden space-y-3">
        <p class="text-sm text-green-600 font-medium">Secret link created:</p>
        <div class="flex gap-2">
          <input id="link" readonly class="flex-1 border rounded px-3 py-2 text-sm bg-gray-50">
          <button id="copyBtn" class="bg-gray-600 text-white px-4 py-2 rounded text-sm">Copy</button>
        </div>
        <p class="text-xs text-gray-500">This link can only be opened once. The encryption key is in the URL and never sent to the server.</p>
      </div>
    </div>

    <div id="viewSection" class="hidden bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <h2 class="text-xl font-semibold">Secret Message</h2>
      <div id="message" class="bg-gray-50 rounded-lg p-4 whitespace-pre-wrap font-mono text-sm"></div>
      <p class="text-sm text-red-600">This message has been destroyed and cannot be viewed again.</p>
    </div>

    <div id="errorSection" class="hidden bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 text-sm"></div>
  </div>

  <script>
    const createBtn = document.getElementById('createBtn');
    const secretEl = document.getElementById('secret');
    const resultEl = document.getElementById('result');
    const linkEl = document.getElementById('link');
    const copyBtn = document.getElementById('copyBtn');
    const createSection = document.getElementById('createSection');
    const viewSection = document.getElementById('viewSection');
    const errorSection = document.getElementById('errorSection');
    const messageEl = document.getElementById('message');

    // Check if this is a view URL
    const pathParts = location.pathname.split('/');
    if (pathParts[1] === 'secret' && pathParts[2]) {
      createSection.classList.add('hidden');
      viewSecret(pathParts[2], location.hash.slice(1));
    }

    createBtn.onclick = async () => {
      const text = secretEl.value.trim();
      if (!text) return alert('Please enter a secret');
      const ttl = parseInt(document.getElementById('ttl').value);

      // Generate key in browser
      const key = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt']);
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const encoded = new TextEncoder().encode(text);
      const encrypted = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, encoded);

      // Export key as base64
      const keyData = await crypto.subtle.exportKey('raw', key);
      const keyB64 = btoa(String.fromCharCode(...new Uint8Array(keyData)));
      const ivB64 = btoa(String.fromCharCode(...iv));
      const dataB64 = btoa(String.fromCharCode(...new Uint8Array(encrypted)));

      const res = await fetch('/api/secret', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: dataB64, iv: ivB64, ttl })
      });
      const json = await res.json();
      if (!json.token) return alert('Failed to create');

      const url = location.origin + '/secret/' + json.token + '#' + keyB64;
      linkEl.value = url;
      resultEl.classList.remove('hidden');
      secretEl.value = '';
    };

    copyBtn.onclick = () => {
      linkEl.select();
      document.execCommand('copy');
      copyBtn.textContent = 'Copied!';
      setTimeout(() => copyBtn.textContent = 'Copy', 2000);
    };

    async function viewSecret(token, keyB64) {
      if (!keyB64) {
        errorSection.textContent = 'Invalid link: missing encryption key';
        errorSection.classList.remove('hidden');
        return;
      }
      try {
        const res = await fetch('/api/secret/' + token);
        if (!res.ok) throw new Error(await res.text());
        const json = await res.json();

        const keyData = Uint8Array.from(atob(keyB64), c => c.charCodeAt(0));
        const key = await crypto.subtle.importKey('raw', keyData, 'AES-GCM', false, ['decrypt']);
        const iv = Uint8Array.from(atob(json.iv), c => c.charCodeAt(0));
        const data = Uint8Array.from(atob(json.data), c => c.charCodeAt(0));

        const decrypted = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, data);
        const text = new TextDecoder().decode(decrypted);

        messageEl.textContent = text;
        viewSection.classList.remove('hidden');
      } catch (e) {
        errorSection.textContent = e.message || 'Secret not found or already viewed';
        errorSection.classList.remove('hidden');
      }
    }
  </script>
</body>
</html>
