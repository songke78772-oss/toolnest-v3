<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CipherDeck - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .grid-cell { min-width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-family: ui-monospace, monospace; font-weight: 600; background: #0c1220; border: 1px solid #1b2740; border-radius: 6px; color: #e6edf7; }
    .cipherbox { word-break: break-all; font-family: ui-monospace, monospace; font-size: 12px; background: #0f1520; border: 1px dashed #22304a; border-radius: 8px; padding: 12px; color: #6ba1ff; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-3xl mx-auto py-10 px-4">
    <a href="/" class="text-blue-600 hover:underline text-sm">← Back to Tools</a>
    <h1 class="text-2xl font-bold mt-2 mb-1">🔐 CipherDeck</h1>
    <p class="text-gray-500 text-sm mb-6">Offline codebook generator. Nothing leaves your browser.</p>

    <div class="flex gap-2 mb-6">
      <button id="tabGen" class="px-4 py-2 rounded bg-blue-600 text-white">Generate</button>
      <button id="tabDec" class="px-4 py-2 rounded bg-gray-200 text-gray-700">Decode / Test</button>
    </div>

    <!-- Generate -->
    <div id="panelGen">
      <div class="bg-white rounded-xl shadow p-6 mb-4">
        <label class="block text-sm font-medium mb-2">Grid size</label>
        <div class="flex gap-3 items-center">
          <select id="size" class="border rounded px-3 py-2">
            <option value="5">5 × 5</option>
            <option value="6">6 × 6</option>
            <option value="7">7 × 7</option>
            <option value="8">8 × 8</option>
            <option value="9" selected>9 × 9</option>
          </select>
          <button id="genBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Generate codebook</button>
        </div>
        <p class="text-xs text-gray-500 mt-2">A–Z (no O) · a–z (no o) · 1–9 (no 0) · safe symbols. Shuffled with crypto randomness.</p>
      </div>

      <div id="gridCard" class="bg-white rounded-xl shadow p-6 mb-4 hidden">
        <div class="flex justify-between items-center mb-3">
          <span class="font-medium">Your codebook</span>
          <span id="lockTag" class="text-amber-600 text-sm hidden">🔒 Downloaded · locked</span>
        </div>
        <div id="grid" class="inline-grid gap-1 mb-4 p-3 bg-gray-900 rounded-lg"></div>
        <p class="text-sm text-red-600 font-bold mb-3 animate-pulse">⚠️ Save it now. Once downloaded, it cannot be downloaded again in this session.</p>        <div class="flex gap-2">
          <button id="dlPng" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">Download PNG</button>
          <button id="dlTxt" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">Download TXT</button>
        </div>
      </div>

      <div id="cipherCard" class="bg-white rounded-xl shadow p-6 hidden">
        <label class="block text-sm font-medium mb-2">Encrypted cipher (portable secret)</label>
        <p class="text-xs text-gray-500 mb-3">Store this anywhere. Useless without the passphrase. Decodes only in a browser.</p>
        <div class="flex gap-2 mb-3">
          <input type="password" id="pass" placeholder="Set a passphrase" class="flex-1 border rounded px-3 py-2">
          <button id="genPass" class="px-3 py-2 border rounded hover:bg-gray-50">Random</button>
          <button id="sealBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Generate cipher</button>
        </div>
        <div id="cipherOut" class="hidden">
          <div id="cipherText" class="cipherbox mb-3"></div>
          <button id="copyCipher" class="px-3 py-2 border rounded hover:bg-gray-50 text-sm">Copy cipher</button>
          <p class="text-xs text-gray-500 mt-3">Send cipher + coordinates. Give passphrase out-of-band. Both needed to recover the grid.</p>
        </div>
      </div>
    </div>

    <!-- Decode -->
    <div id="panelDec" class="hidden">
      <div class="bg-white rounded-xl shadow p-6 mb-4">
        <label class="block text-sm font-medium mb-2">Paste cipher + passphrase</label>
        <textarea id="decCipher" rows="3" placeholder="Paste PTC1-... cipher" class="w-full border rounded px-3 py-2 font-mono text-sm mb-3"></textarea>
        <div class="flex gap-2">
          <input type="password" id="decPass" placeholder="Passphrase" class="flex-1 border rounded px-3 py-2">
          <button id="decBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Decode</button>
        </div>
        <p id="decStatus" class="text-sm mt-2"></p>
      </div>

      <div id="decGridCard" class="bg-white rounded-xl shadow p-6 hidden">
        <label class="block text-sm font-medium mb-2">Codebook unlocked</label>
        <p class="text-xs text-gray-500 mb-4">Matrix not shown. Enter coordinates to check individual characters only.</p>
        <div id="decGrid" class="hidden"></div>
        <label class="block text-sm font-medium mb-2">Look up coordinates</label>
        <p class="text-xs text-gray-500 mb-2">Enter row+col pairs. 74 = row 7, col 4. Separate with spaces: 74 28 91</p>
        <div class="flex gap-2">
          <input type="text" id="coords" placeholder="e.g. 74 28 91" class="flex-1 border rounded px-3 py-2 font-mono">
          <button id="lookupBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Resolve</button>
        </div>
        <div id="lookupOut" class="mt-3 font-mono text-sm"></div>
      </div>
    </div>

    <!-- How to Use -->
    <div class="bg-white rounded-xl shadow p-6 mt-8">
      <h2 class="text-lg font-bold mb-4">How to Use</h2>
      <div class="space-y-4 text-sm text-gray-700">
        <div>
          <p class="font-semibold text-gray-900">① Generate — create the grid</p>
          <p class="mt-1">Pick a size (5×5 to 9×9; larger = harder to guess) → click Generate. The grid is filled with cryptographically secure randomness. Character set: A–Z (no O), a–z (no o), 1–9 (no 0), plus safe symbols — confusing look-alikes are removed on purpose.</p>
        </div>
        <div>
          <p class="font-semibold text-gray-900">② Download — <span class="text-red-600 font-bold">one-time only</span></p>
          <p class="mt-1">Export as PNG (image) or TXT (table with row/column headers). You can download only once — both buttons lock right after the first download. The grid then lives only in this tab's memory — <span class="text-red-600 font-bold">close the page and it's gone forever, unrecoverable.</span> Save it now (print it, or store the file in a password manager).</p>
        </div>
        <div>
          <p class="font-semibold text-gray-900">③ Seal — wrap it in a cipher · <span class="text-red-600 font-bold">REQUIRED, not optional</span></p>
          <p class="mt-1">Set a passphrase (or click "Make passphrase" to generate a strong one) → Generate cipher → you get a PTC1-… string. That string is your entire codebook, encrypted (AES-256-GCM + PBKDF2, 250,000 iterations). <span class="text-red-600 font-bold">It is the only durable copy of your grid — if you skip this, closing the tab destroys the codebook with no way back.</span> Store the cipher anywhere; it's useless without the passphrase.</p>
        </div>
        <div>
          <p class="font-semibold text-gray-900">④ Decode / Test — look up one cell at a time</p>
          <p class="mt-1">Go to the Decode / Test tab → paste the cipher + enter the passphrase → Decode. Decryption happens in memory only; the full grid is deliberately never shown on screen — you'll see just ✓ Decoded. In the lookup box, type pairs like 74 28 91 (first digit = row, second digit = column; separate multiple with spaces or commas) → only that one character is revealed. Read it out or compare it with the other person; <span class="text-red-600 font-bold">the grid stays hidden the whole time.</span></p>
        </div>
      </div>
    </div>

    <p class="text-xs text-gray-400 text-center mt-8">100% client-side. Your matrix is never transmitted or stored on any server.</p>
  </div>

<!-- Important Notes -->
<div class="mt-10">
  <h2 class="text-base font-semibold text-gray-900 mb-4">Important Notes</h2>
  <div class="space-y-3">
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">The grid never touches our server.</span> Generate, download, encrypt, decrypt, lookup — all inside your browser. No backend, no database, no analytics. We have nothing to hand over, because we never receive anything.</p>
    </div>
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">"One-time download" is a convenience lock, not magic.</span> The buttons disable after one download, but once a file leaves your browser you can obviously copy it again. The one real, provable guarantee: the grid is never transmitted to us. That's the line we hold.</p>
    </div>
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">We stop strangers, not insiders.</span> CipherDeck stops an outsider from guessing their way in. It cannot stop someone who already holds the grid (or a file, or a resolved character) from forwarding it. Once a secret is in someone's hands, keeping it is their responsibility, not ours.</p>
    </div>
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">The test page never shows the full grid — by design.</span> A full grid on screen is a fully leaked grid. We resolve one cell at a time, shrinking any single leak to only the cell you just looked up.</p>
    </div>
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">The passphrase is everything.</span> Forget it and the grid is gone forever — no reset, no backdoor, no recovery. That's a feature, not a flaw. Store the passphrase separately from the cipher.</p>
    </div>
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">Size = strength.</span> Every coordinate you reveal leaks one cell. When reusing a codebook, retire a coordinate after use; for high-risk use, generate a fresh codebook every time.</p>
    </div>
    <div class="flex gap-3 text-sm">
      <div class="w-1 bg-amber-400 rounded-full shrink-0"></div>
      <p class="text-gray-600"><span class="font-medium text-gray-900">What it is not.</span> Not military-grade crypto, not DRM, not anonymous, not a replacement for end-to-end encrypted messaging. It's an honest, verifiable "no-server secret agreement" helper.</p>
    </div>
  </div>

  <h3 class="text-base font-semibold text-gray-900 mt-8 mb-3">Before you trust a codebook</h3>
  <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600">
    <li>Seal the grid into a cipher and copy the <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">PTC1-…</code> string — this is required, or the codebook dies with the tab.</li>
    <li>Download and safely store the grid <span class="font-medium text-gray-900">before</span> closing the tab.</li>
    <li>If using a cipher, confirm the decoded size matches your downloaded copy.</li>
    <li>Never send the passphrase through the same channel as the cipher.</li>
  </ol>
</div>
  <canvas id="cv" class="hidden"></canvas>

  <script>
    "use strict";
    // Tabs
    document.getElementById("tabGen").onclick = () => {
      document.getElementById("tabGen").className = "px-4 py-2 rounded bg-blue-600 text-white";
      document.getElementById("tabDec").className = "px-4 py-2 rounded bg-gray-200 text-gray-700";
      document.getElementById("panelGen").classList.remove("hidden");
      document.getElementById("panelDec").classList.add("hidden");
    };
    document.getElementById("tabDec").onclick = () => {
      document.getElementById("tabDec").className = "px-4 py-2 rounded bg-blue-600 text-white";
      document.getElementById("tabGen").className = "px-4 py-2 rounded bg-gray-200 text-gray-700";
      document.getElementById("panelDec").classList.remove("hidden");
      document.getElementById("panelGen").classList.add("hidden");
    };

    // Character pool
    function buildPool() {
      const upper = "ABCDEFGHIJKLMNPQRSTUVWXYZ";
      const lower = "abcdefghijklmnpqrstuvwxyz";
      const digits = "123456789";
      const symbols = "!@#$%^&*-_=+?.,;:~[]{}()";
      return (upper + lower + digits + symbols).split("");
    }
    const POOL = buildPool();

    function shuffle(arr) {
      const a = arr.slice();
      const rnd = new Uint32Array(a.length);
      crypto.getRandomValues(rnd);
      for (let i = a.length - 1; i > 0; i--) {
        const j = rnd[i] % (i + 1);
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }
    function makeGrid(n) {
      if (n * n > POOL.length) throw new Error("Pool too small");
      const pick = shuffle(POOL).slice(0, n * n);
      const grid = [];
      for (let r = 0; r < n; r++) grid.push(pick.slice(r * n, r * n + n));
      return grid;
    }

    function renderGrid(container, grid) {
      const n = grid.length;
      container.innerHTML = "";
      container.style.gridTemplateColumns = "repeat(" + n + ",auto)";
      grid.forEach((row, r) => {
        row.forEach((ch, c) => {
          const d = document.createElement("div");
          d.className = "grid-cell";
          d.textContent = ch;
          d.title = "row " + (r + 1) + ", col " + (c + 1);
          container.appendChild(d);
        });
      });
    }

    let STATE = null;
    let downloaded = false;

    document.getElementById("genBtn").onclick = () => {
      const n = +document.getElementById("size").value;
      STATE = { n, grid: makeGrid(n) };
      renderGrid(document.getElementById("grid"), STATE.grid);
      document.getElementById("gridCard").classList.remove("hidden");
      downloaded = false;
      document.getElementById("lockTag").classList.add("hidden");
      document.getElementById("dlPng").disabled = false;
      document.getElementById("dlTxt").disabled = false;
      document.getElementById("cipherCard").classList.remove("hidden");
      document.getElementById("cipherOut").classList.add("hidden");
      document.getElementById("cipherText").textContent = "";
      document.getElementById("pass").value = "";
    };

    function lockDownloads() {
      downloaded = true;
      document.getElementById("lockTag").classList.remove("hidden");
      document.getElementById("dlPng").disabled = true;
      document.getElementById("dlTxt").disabled = true;
    }

    function gridToText(grid) {
      const n = grid.length;
      let s = "CipherDeck codebook " + n + "x" + n + "\n";
      s += "Read as: row,column -> character\n\n     ";
      for (let c = 1; c <= n; c++) s += String(c).padStart(4);
      s += "\n";
      grid.forEach((row, r) => {
        s += ("R" + (r + 1)).padEnd(6);
        row.forEach(ch => s += ch.padStart(4));
        s += "\n";
      });
      return s;
    }

    function triggerDownload(blob, name) {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = name;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
    }

    document.getElementById("dlTxt").onclick = () => {
      if (!STATE || downloaded) return;
      triggerDownload(new Blob([gridToText(STATE.grid)], { type: "text/plain" }), "cipherdeck-" + STATE.n + "x" + STATE.n + ".txt");
      lockDownloads();
    };

    function drawPNG(grid, n) {
      const cv = document.getElementById("cv");
      const cell = 64, pad = 48, top = 70;
      const size = pad * 2 + cell * n;
      cv.width = size; cv.height = size + top;
      const g = cv.getContext("2d");
      g.fillStyle = "#0b0f17"; g.fillRect(0, 0, cv.width, cv.height);
      g.fillStyle = "#e6edf7"; g.font = "bold 26px sans-serif"; g.textAlign = "center";
      g.fillText("CipherDeck  ·  " + n + " × " + n, cv.width / 2, 42);
      g.font = "12px sans-serif"; g.fillStyle = "#8aa0c2";
      g.fillText("Keep secret · read as row,column", cv.width / 2, 62);
      g.textAlign = "center"; g.textBaseline = "middle";
      for (let r = 0; r < n; r++) {
        for (let c = 0; c < n; c++) {
          const x = pad + c * cell, y = top + pad + r * cell;
          g.fillStyle = "#0c1220"; g.strokeStyle = "#1b2740"; g.lineWidth = 1;
          g.beginPath(); g.roundRect(x, y, cell, cell, 8); g.fill(); g.stroke();
          g.fillStyle = "#e6edf7"; g.font = "bold 26px monospace";
          g.fillText(grid[r][c], x + cell / 2, y + cell / 2 + 1);
        }
      }
    }

    document.getElementById("dlPng").onclick = () => {
      if (!STATE || downloaded) return;
      drawPNG(STATE.grid, STATE.n);
      document.getElementById("cv").toBlob(b => {
        triggerDownload(b, "cipherdeck-" + STATE.n + "x" + STATE.n + ".png");
        lockDownloads();
      }, "image/png");
    };

    // Passphrase generator
    document.getElementById("genPass").onclick = () => {
      const words = ["cobalt","river","maple","quartz","amber","pixel","nomad","delta","iris","zephyr","onyx","lunar","cipher","harbor","velvet","orbit","mango","forte","signal","crystal"];
      const rnd = new Uint32Array(6); crypto.getRandomValues(rnd);
      const pick = Array.from(rnd).map(v => words[v % words.length]);
      const sep = ["-", "."][rnd[0] % 2];
      const num = 100 + (rnd[1] % 900);
      document.getElementById("pass").value = pick.join(sep) + sep + num;
    };

    // Crypto
    const MAGIC = "PTC1";
    function b64urlEncode(bytes) {
      let s = ""; const arr = new Uint8Array(bytes);
      for (let i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
      return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }
    function b64urlDecode(str) {
      str = str.replace(/-/g, "+").replace(/_/g, "/");
      while (str.length % 4) str += "=";
      const s = atob(str); const out = new Uint8Array(s.length);
      for (let i = 0; i < s.length; i++) out[i] = s.charCodeAt(i);
      return out;
    }
    async function deriveKey(pass, salt) {
      const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pass), "PBKDF2", false, ["deriveKey"]);
      return crypto.subtle.deriveKey({ name: "PBKDF2", salt, iterations: 250000, hash: "SHA-256" }, base, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
    }
    async function seal(grid, pass) {
      const n = grid.length;
      const plain = new TextEncoder().encode(grid.map(r => r.join("")).join(""));
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveKey(pass, salt);
      const ct = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, plain));
      const out = new Uint8Array(4 + 1 + 1 + 16 + 12 + ct.length); let p = 0;
      const magicBytes = new TextEncoder().encode(MAGIC); out.set(magicBytes, p); p += 4;
      out[p++] = 0x01; out[p++] = n;
      out.set(salt, p); p += 16;
      out.set(iv, p); p += 12;
      out.set(ct, p);
      return b64urlEncode(out);
    }
    async function openCipher(cipherStr, pass) {
      const raw = b64urlDecode(cipherStr.trim());
      let p = 0;
      const magic = new TextDecoder().decode(raw.slice(p, p + 4)); p += 4;
      if (magic !== MAGIC) throw new Error("Not a CipherDeck cipher.");
      const ver = raw[p++]; if (ver !== 0x01) throw new Error("Unsupported version.");
      const n = raw[p++];
      const salt = raw.slice(p, p + 16); p += 16;
      const iv = raw.slice(p, p + 12); p += 12;
      const ct = raw.slice(p);
      const key = await deriveKey(pass, salt);
      let plain;
      try { plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, ct); }
      catch (e) { throw new Error("Wrong passphrase or tampered cipher."); }
      const str = new TextDecoder().decode(plain);
      if (str.length !== n * n) throw new Error("Corrupt grid length.");
      const grid = [];
      for (let r = 0; r < n; r++) grid.push(str.slice(r * n, r * n + n).split(""));
      return grid;
    }

    document.getElementById("sealBtn").onclick = async () => {
      if (!STATE) { alert("Generate a codebook first."); return; }
      const pass = document.getElementById("pass").value;
      if (!pass) { alert("Set a passphrase first."); return; }
      const btn = document.getElementById("sealBtn");
      btn.disabled = true; btn.textContent = "Sealing…";
      try {
        const cipher = await seal(STATE.grid, pass);
        document.getElementById("cipherText").textContent = MAGIC + "-" + cipher;
        document.getElementById("cipherOut").classList.remove("hidden");
      } catch (e) { alert("Error: " + e.message); }
      btn.disabled = false; btn.textContent = "Generate cipher";
    };

    document.getElementById("copyCipher").onclick = () => {
      navigator.clipboard.writeText(document.getElementById("cipherText").textContent);
    };

    // Decode
    let DEC = null;
    document.getElementById("decBtn").onclick = async () => {
      const c = document.getElementById("decCipher").value.trim();
      const p = document.getElementById("decPass").value;
      const st = document.getElementById("decStatus");
      if (!c || !p) { st.textContent = "Paste cipher and enter passphrase."; st.className = "text-sm mt-2 text-red-600"; return; }
      st.textContent = "Decoding…"; st.className = "text-sm mt-2 text-gray-500";
      try {
        let body = c; if (body.startsWith(MAGIC + "-")) body = body.slice(MAGIC.length + 1);
        const grid = await openCipher(body, p);
        DEC = { n: grid.length, grid };
        document.getElementById("decGrid").innerHTML = "";
        document.getElementById("decGridCard").classList.remove("hidden");
        st.textContent = "✓ Unlocked. Enter coordinates to check characters (matrix not shown).";
        st.className = "text-sm mt-2 text-green-600";
      } catch (e) {
        st.textContent = "✗ " + e.message;
        st.className = "text-sm mt-2 text-red-600";
        document.getElementById("decGridCard").classList.add("hidden");
      }
    };

    document.getElementById("lookupBtn").onclick = () => {
      if (!DEC) { alert("Decode a codebook first."); return; }
      const raw = document.getElementById("coords").value.trim();
      if (!raw) { document.getElementById("lookupOut").innerHTML = ""; return; }
      const n = DEC.n;
      const tokens = raw.split(/[\s,;]+/).filter(Boolean);
      let html = "";
      for (const tok of tokens) {
        if (!/^\d{2,}$/.test(tok)) { html += `<div class="mb-1"><span class="bg-gray-100 px-2 py-1 rounded">${tok}</span> → <span class="text-red-600">invalid</span></div>`; continue; }
        const row = Math.floor(+tok / 10), col = +tok % 10;
        if (row < 1 || row > n || col < 1 || col > n) {
          html += `<div class="mb-1"><span class="bg-gray-100 px-2 py-1 rounded">${tok}</span> → <span class="text-red-600">out of range</span></div>`;
        } else {
          html += `<div class="mb-1"><span class="bg-gray-100 px-2 py-1 rounded">${row}·${col}</span> → <span class="text-green-600 font-bold">${DEC.grid[row - 1][col - 1]}</span></div>`;
        }
      }
      document.getElementById("lookupOut").innerHTML = html;
    };
  </script>
</body>
</html>
