<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flip - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Free online flip tool by ProToolNest.">
  <link rel="canonical" href="https://protoolnest.com/flip"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Flip Image</h1>
      <p class="text-gray-600 mt-2">Flip image horizontally or vertically. All processing happens in your browser.</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div id="uploadArea" class="border-2 border-dashed border-gray-300 rounded-lg p-10 text-center cursor-pointer hover:border-blue-500 transition">
        <div class="text-5xl mb-3">↔️</div>
        <p class="text-lg font-medium text-gray-700">Click or drag image here</p>
        <input type="file" id="fileInput" accept="image/*" class="hidden">
      </div>
      <div id="controls" class="hidden mt-6">
        <img id="preview" class="max-w-full mx-auto rounded border mb-4">
        <div class="flex gap-3 justify-center">
          <button id="flipH" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg">Flip Horizontal</button>
          <button id="flipV" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg">Flip Vertical</button>
          <button id="downloadBtn" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2.5 rounded-lg">Download</button>
          <button id="resetBtn" class="text-gray-600 px-4 py-2.5">Reset</button>
        </div>
      </div>
    </div>
  </div>
  <script>
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const preview = document.getElementById('preview');
    const flipH = document.getElementById('flipH');
    const flipV = document.getElementById('flipV');
    const downloadBtn = document.getElementById('downloadBtn');
    const resetBtn = document.getElementById('resetBtn');
    let currentBlob, originalName = 'image', flipHState = false, flipVState = false;

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('drop', e => { e.preventDefault(); if (e.dataTransfer.files[0]) load(e.dataTransfer.files[0]); });
    uploadArea.addEventListener('dragover', e => e.preventDefault());
    fileInput.addEventListener('change', e => { if (e.target.files[0]) load(e.target.files[0]); });

    function load(file) {
      originalName = file.name.replace(/\.[^/.]+$/, '');
      flipHState = false; flipVState = false;
      const url = URL.createObjectURL(file);
      preview.src = url;
      controls.classList.remove('hidden');
      // store original as blob later on flip
    }

    function applyFlip() {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.width; canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.save();
        if (flipHState) { ctx.translate(canvas.width, 0); ctx.scale(-1, 1); }
        if (flipVState) { ctx.translate(0, canvas.height); ctx.scale(1, -1); }
        ctx.drawImage(img, 0, 0);
        ctx.restore();
        canvas.toBlob(blob => {
          currentBlob = blob;
          preview.src = URL.createObjectURL(blob);
        }, 'image/jpeg', 0.92);
      };
      img.src = preview.src;
    }

    flipH.addEventListener('click', () => { flipHState = !flipHState; applyFlip(); });
    flipV.addEventListener('click', () => { flipVState = !flipVState; applyFlip(); });

    downloadBtn.addEventListener('click', () => {
      if (!currentBlob) return alert('Flip the image first');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(currentBlob);
      a.download = 'flipped_' + originalName + '.jpg';
      a.click();
    });

    resetBtn.addEventListener('click', () => { controls.classList.add('hidden'); fileInput.value = ''; });
  </script>
</body>
</html>
