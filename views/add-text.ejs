<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Text - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Free online add text tool by ProToolNest.">
  <link rel="canonical" href="https://protoolnest.com/add-text"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Add Text to Image</h1>
      <p class="text-gray-600 mt-2">Add text on top of your image. All processing happens in your browser.</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div id="uploadArea" class="border-2 border-dashed border-gray-300 rounded-lg p-10 text-center cursor-pointer hover:border-blue-500 transition">
        <div class="text-5xl mb-3">📝</div>
        <p class="text-lg font-medium text-gray-700">Click or drag image here</p>
        <input type="file" id="fileInput" accept="image/*" class="hidden">
      </div>
      <div id="controls" class="hidden mt-6 space-y-4">
        <input type="text" id="textInput" placeholder="Enter text..." class="w-full border rounded-lg px-3 py-2">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-sm">Font Size</label>
            <input type="number" id="fontSize" value="48" class="w-full border rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="text-sm">Text Color</label>
            <input type="color" id="textColor" value="#ffffff" class="w-full h-10 border rounded-lg">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-sm">X Position (%)</label>
            <input type="number" id="posX" value="50" min="0" max="100" class="w-full border rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="text-sm">Y Position (%)</label>
            <input type="number" id="posY" value="50" min="0" max="100" class="w-full border rounded-lg px-3 py-2">
          </div>
        </div>
        <button id="applyBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg">Apply Text</button>
        <img id="result" class="max-w-full rounded border mt-4 hidden">
        <button id="downloadBtn" class="hidden bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg">Download</button>
        <button id="resetBtn" class="ml-3 text-gray-600 px-4 py-2.5">Reset</button>
      </div>
    </div>
  </div>
  <script>
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const textInput = document.getElementById('textInput');
    const fontSize = document.getElementById('fontSize');
    const textColor = document.getElementById('textColor');
    const posX = document.getElementById('posX');
    const posY = document.getElementById('posY');
    const applyBtn = document.getElementById('applyBtn');
    const result = document.getElementById('result');
    const downloadBtn = document.getElementById('downloadBtn');
    const resetBtn = document.getElementById('resetBtn');
    let originalFile, resultBlob, originalName = 'image';

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('drop', e => { e.preventDefault(); if (e.dataTransfer.files[0]) load(e.dataTransfer.files[0]); });
    uploadArea.addEventListener('dragover', e => e.preventDefault());
    fileInput.addEventListener('change', e => { if (e.target.files[0]) load(e.target.files[0]); });

    function load(file) {
      originalFile = file;
      originalName = file.name.replace(/\.[^/.]+$/, '');
      controls.classList.remove('hidden');
      result.classList.add('hidden');
      downloadBtn.classList.add('hidden');
    }

    applyBtn.addEventListener('click', () => {
      if (!originalFile || !textInput.value) return alert('Please upload image and enter text');
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.width; canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        ctx.font = `bold ${fontSize.value}px Arial`;
        ctx.fillStyle = textColor.value;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        const x = (posX.value / 100) * canvas.width;
        const y = (posY.value / 100) * canvas.height;
        ctx.fillText(textInput.value, x, y);
        canvas.toBlob(blob => {
          resultBlob = blob;
          result.src = URL.createObjectURL(blob);
          result.classList.remove('hidden');
          downloadBtn.classList.remove('hidden');
        }, 'image/jpeg', 0.92);
      };
      img.src = URL.createObjectURL(originalFile);
    });

    downloadBtn.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(resultBlob);
      a.download = 'text_' + originalName + '.jpg';
      a.click();
    });

    resetBtn.addEventListener('click', () => { controls.classList.add('hidden'); fileInput.value = ''; });
  </script>
</body>
</html>
