<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Base64 Encode/Decode - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Base64 Encode / Decode</h1>
    <p class="text-gray-600 mb-6">Encode text to Base64 or decode Base64 to text.</p>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="input" rows="6" class="w-full border rounded-lg p-4" placeholder="Enter text or Base64..."></textarea>
      <div class="flex gap-2">
        <button id="encode" class="bg-blue-600 text-white px-4 py-2 rounded-lg">Encode</button>
        <button id="decode" class="bg-blue-600 text-white px-4 py-2 rounded-lg">Decode</button>
      </div>
      <textarea id="output" rows="6" class="w-full border rounded-lg p-4 bg-gray-50" readonly></textarea>
    </div>
  </div>
  <script>
    document.getElementById('encode').onclick = () => {
      document.getElementById('output').value = btoa(unescape(encodeURIComponent(document.getElementById('input').value)));
    };
    document.getElementById('decode').onclick = () => {
      try {
        document.getElementById('output').value = decodeURIComponent(escape(atob(document.getElementById('input').value)));
      } catch { document.getElementById('output').value = 'Invalid Base64'; }
    };
  </script>
</body>
</html>
