<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white">
  <div class="p-6 max-w-3xl mx-auto">
    <h2 class="text-xl font-semibold mb-6">Residential Lease Agreement</h2>

    <!-- Step 1: Country & Region -->
    <div class="mb-8 p-5 bg-gray-50 rounded-xl border border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium text-gray-700">Country</label>
          <select id="country" onchange="onCountryChange()" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
            <option value="">Select Country</option>
          </select>
        </div>
        <div id="regionContainer" class="hidden">
          <label class="block text-sm font-medium text-gray-700">State / Region</label>
          <select id="region" onchange="onRegionChange()" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
            <option value="">Select</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Dynamic Form -->
    <div id="leaseFormContainer" class="hidden">
      <form id="leaseForm" class="space-y-5"></form>
      <button type="button" onclick="generateLease()" class="mt-6 bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 font-medium">
        Generate PDF
      </button>
      <div id="status" class="mt-3 text-sm text-gray-500 hidden"></div>
    </div>
  </div>

  <script>
    let availableData = null;
    let currentTemplate = null;

    // 页面加载时获取可用地区
    async function init() {
      try {
        const res = await fetch('/api/legal/lease/available');
        const data = await res.json();
        availableData = data.countries || {};

        const countrySelect = document.getElementById('country');
        Object.keys(availableData).forEach(key => {
          const opt = document.createElement('option');
          opt.value = key;
          opt.textContent = availableData[key].name;
          countrySelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Failed to load available regions', e);
      }
    }

    function onCountryChange() {
      const country = document.getElementById('country').value;
      const regionSelect = document.getElementById('region');
      const container = document.getElementById('regionContainer');

      regionSelect.innerHTML = '<option value="">Select</option>';
      document.getElementById('leaseFormContainer').classList.add('hidden');

      if (!country || !availableData[country]) {
        container.classList.add('hidden');
        return;
      }

      availableData[country].regions.forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.file;
        opt.textContent = r.name;
        regionSelect.appendChild(opt);
      });

      container.classList.remove('hidden');
    }

    async function onRegionChange() {
      const file = document.getElementById('region').value;
      if (!file) return;

      try {
        const res = await fetch(`/templates/lease/${file}`);
        currentTemplate = await res.json();
        renderForm(currentTemplate);
        document.getElementById('leaseFormContainer').classList.remove('hidden');
      } catch (e) {
        alert('Failed to load template');
        console.error(e);
      }
    }

    function renderForm(data) {
      const form = document.getElementById('leaseForm');
      form.innerHTML = '';

      // 基础当事人信息
      form.innerHTML += `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-gray-700">Landlord Name *</label>
            <input type="text" name="landlordName" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Landlord Address</label>
            <input type="text" name="landlordAddress" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Landlord Phone</label>
            <input type="text" name="landlordPhone" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Landlord Email</label>
            <input type="email" name="landlordEmail" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Tenant Name *</label>
            <input type="text" name="tenantName" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Tenant Address</label>
            <input type="text" name="tenantAddress" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Tenant Phone</label>
            <input type="text" name="tenantPhone" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Tenant Email</label>
            <input type="email" name="tenantEmail" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
          </div>
        </div>
      `;

      (data.requiredUserFields || []).forEach(field => {
        let input = '';
        const note = field.note ? `<p class="text-xs text-gray-500 mt-1">${field.note}</p>` : '';

        if (field.type === 'select') {
          input = `<select name="${field.key}" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" ${field.required ? 'required' : ''}>
            <option value="">Select</option>
            ${(field.options || []).map(o => `<option value="${o}">${o}</option>`).join('')}
          </select>`;
        } else if (field.type === 'textarea') {
          input = `<textarea name="${field.key}" rows="3" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" ${field.required ? 'required' : ''}></textarea>`;
        } else if (field.type === 'boolean') {
          input = `<select name="${field.key}" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
            <option value="false">No</option>
            <option value="true">Yes</option>
          </select>`;
        } else {
          const type = field.type === 'number' ? 'number' : field.type === 'date' ? 'date' : 'text';
          input = `<input type="${type}" name="${field.key}" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" ${field.required ? 'required' : ''} ${field.default !== undefined ? `value="${field.default}"` : ''}>`;
        }

        form.innerHTML += `
          <div>
            <label class="block text-sm font-medium text-gray-700">${field.label}${field.required ? ' *' : ''}</label>
            ${input}
            ${note}
          </div>
        `;
      });
    }

    async function generateLease() {
      if (!currentTemplate) return alert('Please select a region first');

      const form = document.getElementById('leaseForm');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // 补充基础字段
      data.effectiveDate = new Date().toLocaleDateString('en-US');
      data.jurisdiction = currentTemplate.stateName || currentTemplate.countryName || '';

      const status = document.getElementById('status');
      status.textContent = 'Generating PDF...';
      status.classList.remove('hidden');

      try {
        const res = await fetch('/api/legal/lease/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formData: data, template: currentTemplate })
        });

        if (!res.ok) throw new Error('Generation failed');

        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Residential-Lease-Agreement.pdf';
        a.click();
        URL.revokeObjectURL(url);

        status.textContent = 'PDF downloaded.';
      } catch (err) {
        status.textContent = 'Failed to generate PDF.';
        console.error(err);
        alert('Failed to generate PDF');
      }
    }

    // 启动
    init();
  </script>
</body>
</html>
