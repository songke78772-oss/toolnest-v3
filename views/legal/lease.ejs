<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white">
  <div class="p-6">
    <h2 class="text-xl font-semibold mb-6">Residential Lease Agreement</h2>

    <!-- Step 1: Country & Region -->
    <div class="mb-8 p-5 bg-gray-50 rounded-xl border border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium text-gray-700">Country</label>
          <select id="country" onchange="onCountryChange()" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
            <option value="">Select Country</option>
          </select>
        </div>
        <div id="regionContainer" class="hidden">
          <label class="block text-sm font-medium text-gray-700">State / Region</label>
          <select id="region" onchange="onRegionChange()" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
            <option value="">Select</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Dynamic Form -->
    <div id="leaseFormContainer" class="hidden">
      <form id="leaseForm" class="space-y-5"></form>
      <button type="button" onclick="generateLease()" class="mt-6 bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 font-medium">
        Generate Document
      </button>

      <div id="leaseResult" class="mt-8 hidden">
        <div class="flex justify-between items-center mb-3">
          <h3 class="font-semibold">Generated Document</h3>
          <div class="space-x-2">
            <button onclick="copyLease()" class="text-sm bg-gray-100 px-3 py-1.5 rounded hover:bg-gray-200">Copy</button>
            <button onclick="downloadLease()" class="text-sm bg-gray-100 px-3 py-1.5 rounded hover:bg-gray-200">Download .txt</button>
          </div>
        </div>
        <pre id="leaseOutput" class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-sm whitespace-pre-wrap font-mono"></pre>
      </div>
    </div>
  </div>

  <script>
    let availableData = null;
    let currentTemplate = null;

    // 页面加载时获取可用地区
    async function init() {
      try {
        const res = await fetch('/api/legal/lease/available');
        const data = await res.json();
        availableData = data.countries || {};

        const countrySelect = document.getElementById('country');
        Object.keys(availableData).forEach(key => {
          const opt = document.createElement('option');
          opt.value = key;
          opt.textContent = availableData[key].name;
          countrySelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Failed to load available regions', e);
      }
    }

    function onCountryChange() {
      const country = document.getElementById('country').value;
      const regionSelect = document.getElementById('region');
      const container = document.getElementById('regionContainer');

      regionSelect.innerHTML = '<option value="">Select</option>';
      document.getElementById('leaseFormContainer').classList.add('hidden');

      if (!country || !availableData[country]) {
        container.classList.add('hidden');
        return;
      }

      availableData[country].regions.forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.file;
        opt.textContent = r.name;
        regionSelect.appendChild(opt);
      });

      container.classList.remove('hidden');
    }

    async function onRegionChange() {
      const file = document.getElementById('region').value;
      if (!file) return;

      try {
        const res = await fetch(`/templates/lease/${file}`);
        currentTemplate = await res.json();
        renderForm(currentTemplate);
        document.getElementById('leaseFormContainer').classList.remove('hidden');
      } catch (e) {
        alert('Failed to load template');
        console.error(e);
      }
    }

    function renderForm(data) {
      const form = document.getElementById('leaseForm');
      form.innerHTML = '';

      // 基础当事人信息
      form.innerHTML += `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-gray-700">Landlord Name *</label>
            <input type="text" name="landlordName" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Tenant Name *</label>
            <input type="text" name="tenantName" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" required>
          </div>
        </div>
      `;

      (data.requiredUserFields || []).forEach(field => {
        let input = '';
        const note = field.note ? `<p class="text-xs text-gray-500 mt-1">${field.note}</p>` : '';

        if (field.type === 'select') {
          input = `<select name="${field.key}" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" ${field.required ? 'required' : ''}>
            <option value="">Select</option>
            ${(field.options || []).map(o => `<option value="${o}">${o}</option>`).join('')}
          </select>`;
        } else if (field.type === 'textarea') {
          input = `<textarea name="${field.key}" rows="3" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" ${field.required ? 'required' : ''}></textarea>`;
        } else if (field.type === 'boolean') {
          input = `<select name="${field.key}" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2">
            <option value="false">No</option>
            <option value="true">Yes</option>
          </select>`;
        } else {
          const type = field.type === 'number' ? 'number' : field.type === 'date' ? 'date' : 'text';
          input = `<input type="${type}" name="${field.key}" class="mt-1 block w-full border border-gray-300 rounded-lg px-3 py-2" ${field.required ? 'required' : ''} ${field.default !== undefined ? `value="${field.default}"` : ''}>`;
        }

        form.innerHTML += `
          <div>
            <label class="block text-sm font-medium text-gray-700">${field.label}${field.required ? ' *' : ''}</label>
            ${input}
            ${note}
          </div>
        `;
      });
    }

    function generateLease() {
      if (!currentTemplate) return alert('Please select a region first');

      const formData = new FormData(document.getElementById('leaseForm'));
      const data = Object.fromEntries(formData.entries());

      const landlord = data.landlordName || '[Landlord Name]';
      const tenant = data.tenantName || '[Tenant Name]';
      const jurisdiction = currentTemplate.stateName || currentTemplate.countryName || 'Unknown';

      // 处理条件披露（以加州为例，其他地区可按需扩展）
      let flood = '';
      let lead = '';
      let ab1482 = '';

      if (currentTemplate.conditionalDisclosures) {
        const cd = currentTemplate.conditionalDisclosures;
        if (cd.floodDisclosure) {
          flood = data.inFloodZone === 'true' ? cd.floodDisclosure.ifTrue : cd.floodDisclosure.ifFalse;
        }
        if (cd.leadDisclosure) {
          lead = (data.yearBuilt && parseInt(data.yearBuilt) < 1978)
            ? cd.leadDisclosure.ifBefore1978
            : cd.leadDisclosure.ifAfter1978;
        }
        if (cd.ab1482Status) {
          ab1482 = cd.ab1482Status.covered || '';
        }
      }

      let disclosures = '';
      if (currentTemplate.templateOverrides?.stateDisclosures) {
        disclosures = currentTemplate.templateOverrides.stateDisclosures
          .replace('{{floodDisclosure}}', flood)
          .replace('{{leadDisclosure}}', lead)
          .replace('{{ab1482Status}}', ab1482);
      }

      let additional = currentTemplate.templateOverrides?.additionalTerms || '{{additionalTerms}}';
      additional = additional.replace('{{additionalTerms}}', data.additionalTerms || 'None');

      const depositClause = currentTemplate.templateOverrides?.stateSecurityDepositClause || 
        `The Tenant shall pay a security deposit of $${data.depositAmount || '[Deposit]'}.`;

      const doc = `RESIDENTIAL LEASE AGREEMENT
${jurisdiction}

This Residential Lease Agreement ("Agreement") is entered into on ${new Date().toLocaleDateString()} between:

Landlord: ${landlord}
Tenant: ${tenant}

1. PREMISES
The Landlord agrees to rent to the Tenant the premises located at:
${data.propertyAddress || '[Address]'}
${data.premisesDescription ? '\nDescription: ' + data.premisesDescription : ''}
${data.excludedAreas ? '\nExcluded Areas: ' + data.excludedAreas : ''}

2. TERM
The lease term begins on ${data.startDate || '[Start Date]'} and ends on ${data.endDate || '[End Date]'}.

3. RENT
Monthly rent is $${data.rentAmount || '[Rent]'}, payable by ${data.paymentMethod || '[Payment Method]'}.

4. SECURITY DEPOSIT
${depositClause}

Security Deposit Amount: $${data.depositAmount || '[Deposit]'}

5. OCCUPANCY
Approved Occupants: ${data.approvedOccupants || 'None specified'}
Maximum Occupancy: ${data.maxOccupants || 'N/A'}

6. POLICIES
Smoking/Vaping: ${data.smokingPolicy || 'As permitted by law'}
Pets: ${data.petPolicy || 'No pets unless otherwise agreed in writing'}

7. ENTRY
Landlord shall provide at least ${data.entryNoticeHours || currentTemplate.templateOverrides?.entryNoticeHours || '24'} hours written notice before entry (non-emergency).

8. REQUIRED DISCLOSURES
${disclosures || 'None specified.'}

9. ADDITIONAL TERMS
${additional}

IN WITNESS WHEREOF, the parties have executed this Agreement.

Landlord: ___________________________     Date: _______________

Tenant: _____________________________     Date: _______________

---
Disclaimer: This document is a template for informational purposes only and does not constitute legal advice. Consult a qualified attorney before use.`;

      document.getElementById('leaseOutput').textContent = doc;
      document.getElementById('leaseResult').classList.remove('hidden');
    }

    function copyLease() {
      const text = document.getElementById('leaseOutput').textContent;
      navigator.clipboard.writeText(text).then(() => alert('Copied!'));
    }

    function downloadLease() {
      const text = document.getElementById('leaseOutput').textContent;
      const blob = new Blob([text], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Residential-Lease-Agreement.txt';
      a.click();
      URL.revokeObjectURL(url);
    }

    // 启动
    init();
  </script>
</body>
</html>
