<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Case Converter - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Convert text to uppercase, lowercase, title case, and more.">
  <link rel="canonical" href="https://protoolnest.com/case-converter"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Case Converter</h1>
    <p class="text-gray-600 mb-6">Convert text to different cases.</p>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="input" rows="6" class="w-full border rounded-lg p-4" placeholder="Enter text..."></textarea>
      <div class="flex flex-wrap gap-2">
        <button onclick="convert('upper')" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">UPPERCASE</button>
        <button onclick="convert('lower')" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">lowercase</button>
        <button onclick="convert('title')" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">Title Case</button>
        <button onclick="convert('sentence')" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">Sentence case</button>
      </div>
      <textarea id="output" rows="6" class="w-full border rounded-lg p-4 bg-gray-50" readonly></textarea>
    </div>
  </div>
  <script>
    function convert(type) {
      const t = document.getElementById('input').value;
      let r = t;
      if (type === 'upper') r = t.toUpperCase();
      if (type === 'lower') r = t.toLowerCase();
      if (type === 'title') r = t.replace(/\w\S*/g, w => w.charAt(0).toUpperCase() + w.substr(1).toLowerCase());
      if (type === 'sentence') r = t.toLowerCase().replace(/(^\s*\w|[.!?]\s*\w)/g, c => c.toUpperCase());
      document.getElementById('output').value = r;
    }
  </script>
</body>
</html>
