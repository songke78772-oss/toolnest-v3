<!DOCTYPE html>
<html>
<head>
  <title>Subscribe - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
  <div class="bg-white p-8 rounded-lg shadow-md max-w-md w-full text-center">
    <h1 class="text-2xl font-bold mb-4">Unlock All Tools</h1>
    <p class="text-gray-600 mb-6">
      Your free trial has ended.<br>
      Subscribe for just $1.99/month to continue using all tools.
    </p>
    
    <button onclick="subscribe()" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 w-full">
      Subscribe Now - $1.99/month
    </button>
    
    <p class="text-sm text-gray-500 mt-4">Cancel anytime</p>
  </div>

  <script>
    async function subscribe() {
      const res = await fetch('/create-checkout', { method: 'POST' });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Failed to create checkout');
      }
    }
  </script>
</body>
</html>
