<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen">
  <div class="bg-white p-8 rounded-lg shadow w-full max-w-md">
    <h1 class="text-2xl font-bold text-center mb-6">Register</h1>
    <% if (error) { %><p class="text-red-600 text-center mb-4"><%= error %></p><% } %>
    <form action="/register" method="POST" class="space-y-4">
      <input type="email" name="email" required placeholder="Email" class="w-full border rounded px-4 py-3">
      <input type="password" name="password" required placeholder="Password" class="w-full border rounded px-4 py-3">
      <input type="password" name="confirmPassword" required placeholder="Confirm Password" class="w-full border rounded px-4 py-3">
      <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded">Register</button>
    </form>
    <p class="text-center mt-4 text-sm">Already have an account? <a href="/login" class="text-blue-600">Login</a></p>
  </div>
</body>
</html>
