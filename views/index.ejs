<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ProToolNest - Online PDF, Image, AI Writing & Office Tools</title>
  <meta name="description" content="ProToolNest offers fast online tools for PDF translation, image processing, AI writing, and office productivity. Simple, affordable, $3.99/month after free trial.">
  <meta name="keywords" content="online tools, PDF translator, AI writer, image tools, office tools, productivity">
  <link rel="canonical" href="https://protoolnest.com/">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-indigo-600">ProToolNest</a>
      <nav class="flex gap-6 text-sm items-center">
        <a href="/#tools" class="hover:text-indigo-600">Tools</a>
        <a href="/pricing" class="hover:text-indigo-600">Pricing</a>
        <% if (loggedIn) { %>
          <a href="/dashboard" class="hover:text-indigo-600">Dashboard</a>
          <a href="/logout" class="hover:text-indigo-600">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-indigo-600">Login</a>
          <a href="/register" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700">Start Free Trial</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-12">
    <section class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Simple Online Tools for Everyday Work</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">
        PDF translation, AI writing assistants, image tools, and office utilities — all in one place. 
        Start with a free trial, then just $3.99/month.
      </p>
      <% if (!loggedIn) { %>
        <a href="/register" class="inline-block bg-indigo-600 text-white text-lg px-8 py-3 rounded-xl hover:bg-indigo-700">
          Try All Tools Free for 3 Days
        </a>
      <% } %>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Popular Categories</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/?category=Office" class="bg-white p-6 rounded-xl border hover:shadow-md text-center">
          <div class="text-3xl mb-2">📄</div>
          <div class="font-medium">Office</div>
        </a>
        <a href="/?category=AI" class="bg-white p-6 rounded-xl border hover:shadow-md text-center">
          <div class="text-3xl mb-2">✨</div>
          <div class="font-medium">AI Writing</div>
        </a>
        <a href="/?category=PDF" class="bg-white p-6 rounded-xl border hover:shadow-md text-center">
          <div class="text-3xl mb-2">📑</div>
          <div class="font-medium">PDF</div>
        </a>
        <a href="/?category=Image" class="bg-white p-6 rounded-xl border hover:shadow-md text-center">
          <div class="text-3xl mb-2">🖼️</div>
          <div class="font-medium">Image</div>
        </a>
      </div>
    </section>

    <!-- Search -->
    <div class="mb-8">
      <form action="/" method="get" class="max-w-md mx-auto">
        <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" 
               placeholder="Search tools..." 
               class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </form>
    </div>

    <!-- All Tools -->
    <section id="tools">
      <h2 class="text-2xl font-semibold mb-6">All Tools</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (tools && tools.length > 0) { %>
          <% tools.forEach(tool => { %>
            <a href="/tool/<%= tool.id %>" class="bg-white p-6 rounded-xl border hover:shadow-md block">
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-semibold"><%= tool.name %></h3>
                <% if (tool.category) { %>
                  <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded"><%= tool.category %></span>
                <% } %>
              </div>
              <p class="text-sm text-gray-600"><%= tool.description || 'Online tool' %></p>
            </a>
          <% }) %>
        <% } else { %>
          <p class="text-gray-500 col-span-full">No tools found.</p>
        <% } %>
      </div>
    </section>

    <!-- Tool Request -->
    <section class="mt-16 bg-white p-8 rounded-xl border">
      <h2 class="text-xl font-semibold mb-4">Request a Tool</h2>
      <form action="/request-tool" method="post" class="space-y-4 max-w-lg">
        <input type="email" name="email" placeholder="Your email" required class="w-full px-4 py-2 border rounded-lg">
        <textarea name="content" placeholder="What tool do you need?" required rows="3" class="w-full px-4 py-2 border rounded-lg"></textarea>
        <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700">Submit Request</button>
      </form>
    </section>
  </main>

  <footer class="bg-white border-t mt-20">
    <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-gray-500 flex flex-col md:flex-row justify-between gap-4">
      <div>© 2026 ProToolNest. All rights reserved.</div>
      <div class="flex gap-4">
        <a href="/terms" class="hover:text-indigo-600">Terms</a>
        <a href="/privacy" class="hover:text-indigo-600">Privacy</a>
        <a href="/refund" class="hover:text-indigo-600">Refund Policy</a>
        <a href="/disclaimer" class="hover:text-indigo-600">Disclaimer</a>
      </div>
    </div>
  </footer>
</body>
</html>
