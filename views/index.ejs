<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolNest - Online Tools</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">

<nav class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold text-blue-600">ToolNest</a>
    <div class="flex items-center gap-4">
      <% if (loggedIn) { %>
        <a href="/dashboard" class="text-sm text-gray-600">Dashboard</a>
        <a href="/logout" class="text-sm text-gray-600">Logout</a>
      <% } else { %>
        <a href="/login" class="text-sm text-gray-600">Login</a>
        <a href="/register" class="text-sm bg-blue-600 text-white px-4 py-2 rounded-lg">Get Started</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="bg-white">
  <div class="max-w-4xl mx-auto px-4 pt-12 pb-8 text-center">
    <h1 class="text-4xl font-bold text-gray-900 mb-3">Free Tools to Make <span class="text-blue-600">Your Life</span> Simple</h1>
    <p class="text-gray-500 mb-6">Useful online tools. Always available.</p>
    <form action="/" method="get" class="max-w-xl mx-auto flex gap-2">
      <input type="text" name="q" value="<%= q %>" placeholder="Search tools..." class="flex-1 border rounded-full px-5 py-3 focus:outline-none focus:border-blue-400">
      <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-full">Search</button>
    </form>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex gap-2 flex-wrap mb-6">
    <a href="/" class="px-4 py-2 rounded-full text-sm <%= !cat ? 'bg-blue-600 text-white' : 'bg-white border' %>">All</a>
    <% categories.forEach(c => { %>
      <a href="/?cat=<%= c %>" class="px-4 py-2 rounded-full text-sm <%= cat === c ? 'bg-blue-600 text-white' : 'bg-white border' %>"><%= c %></a>
    <% }) %>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% tools.forEach(tool => { %>
      <div class="bg-white rounded-xl border p-5 hover:shadow-md transition">
        <div class="flex items-start justify-between">
          <div class="text-3xl"><%= tool.icon %></div>
          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded"><%= tool.category %></span>
        </div>
        <h3 class="font-semibold mt-3"><%= tool.name %></h3>
        <p class="text-sm text-gray-500 mt-1"><%= tool.description || '' %></p>
        <div class="flex items-center justify-between mt-4">
          <span class="text-xs text-gray-400">Used <%= tool.usage_count || 0 %> times</span>
          <% if (loggedIn) { %>
            <a href="/tool/<%= tool.id %>" class="text-sm text-blue-600">Use →</a>
          <% } else { %>
            <a href="/login" class="text-sm text-blue-600">Login to use</a>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (tools.length === 0) { %>
    <p class="text-center text-gray-500 py-12">No tools found.</p>
  <% } %>
</div>

<div class="bg-white border-t mt-12">
  <div class="max-w-md mx-auto px-4 py-12 text-center">
    <h2 class="text-xl font-bold mb-2">Can't find what you need?</h2>
    <p class="text-gray-500 text-sm mb-4">Tell us what tool you want.</p>
    <% if (requested) { %>
      <p class="text-green-600 text-sm mb-4">Thanks! We'll notify you when it's ready.</p>
    <% } %>
    <form action="/request-tool" method="post" class="space-y-3">
      <input type="email" name="email" required placeholder="Your email" class="w-full border rounded-lg px-4 py-3 text-sm">
      <textarea name="request" required placeholder="Describe the tool..." class="w-full border rounded-lg px-4 py-3 text-sm" rows="3"></textarea>
      <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg">Submit</button>
    </form>
  </div>
</div>

<footer class="bg-gray-900 text-gray-400 py-6 text-center text-sm">
  <p>ToolNest &copy; 2026</p>
</footer>

</body>
</html>
