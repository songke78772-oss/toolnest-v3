<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <title>ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white border-b px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-2xl font-bold text-blue-600">ToolNest</a>
    <div class="flex items-center gap-4">
      <% if (loggedIn) { %>
        <a href="/dashboard" class="text-sm text-gray-600">Dashboard</a>
        <a href="/logout" class="text-sm text-gray-600">Logout</a>
      <% } else { %>
        <a href="/login" class="text-sm text-gray-600">Login</a>
        <a href="/register" class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">Register</a>
      <% } %>
    </div>
  </nav>

  <div class="max-w-4xl mx-auto px-4 py-12 text-center">
    <h1 class="text-4xl font-bold mb-4">ToolNest</h1>
    <p class="text-gray-500 mb-6">Useful online tools. Always available.</p>
    <form action="/" method="get" class="max-w-xl mx-auto flex gap-2">
      <input type="text" name="q" value="<%= q %>" placeholder="Search tools..." class="flex-1 border rounded-full px-5 py-3 focus:outline-none focus:border-blue-400">
      <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-full">Search</button>
    </form>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% tools.forEach(tool => { %>
        <div class="bg-white rounded-xl p-5 border">
          <div class="flex justify-between items-start mb-2">
            <h3 class="font-semibold"><%= tool.name %></h3>
            <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full"><%= tool.category || 'Tool' %></span>
          </div>
          <p class="text-sm text-gray-500 mb-4"><%= tool.description || '' %></p>
          <a href="<%= tool.url || '#' %>" class="text-blue-600 text-sm">Open →</a>
        </div>
      <% }) %>
    </div>
    <% if (tools.length === 0) { %>
      <p class="text-center text-gray-400 py-12">No tools yet.</p>
    <% } %>
  </div>
</body>
</html>
