<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Legal Document Generator - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <div class="max-w-5xl mx-auto py-8 px-4">
    <h1 class="text-3xl font-bold text-gray-900">Legal Document Generator</h1>
    <p class="text-gray-600 mt-2">Generate professional legal documents in minutes</p>

    <!-- 说明与免责声明 -->
    <div class="mt-6 p-5 bg-blue-50 border border-blue-100 rounded-xl text-sm text-gray-700 leading-relaxed">
      <p class="font-medium text-blue-900 mb-2">About This Tool</p>
      <p>
        This tool helps you quickly generate commonly used legal documents (such as residential leases, NDAs, independent contractor agreements, etc.) based on standard templates. 
        We periodically update the templates according to changes in relevant laws and regulations.
      </p>
      <p class="mt-3">
        <strong>Important Disclaimer:</strong> The documents generated by this tool are for reference and general informational purposes only. They do <strong>not</strong> constitute legal advice and are <strong>not</strong> a substitute for documents prepared or reviewed by a licensed attorney or qualified legal professional. 
        Laws vary by jurisdiction and individual circumstances. We strongly recommend consulting with a qualified attorney before using any generated document for actual transactions or legal purposes.
      </p>
    </div>

    <!-- Tabs -->
    <div class="mt-6 border-b border-gray-200">
      <nav class="-mb-px flex space-x-8" aria-label="Tabs">
        <button onclick="switchTab('lease')" id="tab-lease" class="tab-btn border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
          Residential Lease Agreement
        </button>
        <button onclick="switchTab('nda')" id="tab-nda" class="tab-btn border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
          NDA (Non-Disclosure Agreement)
        </button>
      </nav>
    </div>

    <!-- Content Areas -->
    <div id="content-lease" class="tab-content mt-6">
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500">
        Residential Lease Agreement<br>
        <span class="text-sm">Form will be added here</span>
      </div>
    </div>

    <div id="content-nda" class="tab-content mt-6 hidden">
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500">
        NDA (Non-Disclosure Agreement)<br>
        <span class="text-sm">Form will be added here</span>
      </div>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      // Hide all content
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      // Reset all tabs
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('border-blue-500', 'text-blue-600');
        el.classList.add('border-transparent', 'text-gray-500');
      });

      // Show selected
      document.getElementById('content-' + tab).classList.remove('hidden');
      const activeTab = document.getElementById('tab-' + tab);
      activeTab.classList.remove('border-transparent', 'text-gray-500');
      activeTab.classList.add('border-blue-500', 'text-blue-600');
    }
  </script>
</body>
</html>
