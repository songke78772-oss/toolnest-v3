<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chart - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <meta name="description" content="Free online chart tool by ProToolNest.">
  <link rel="canonical" href="https://protoolnest.com/chart"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Chart Maker</h1>
      <p class="text-gray-600 mt-2">Create a simple bar chart and export as image. All processing happens in your browser.</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="data" rows="6" class="w-full border rounded-lg p-3 font-mono text-sm" placeholder="Label1, 10&#10;Label2, 25&#10;Label3, 15"></textarea>
      <button id="makeBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg">Generate Chart</button>
      <canvas id="chart" class="max-w-full mt-4 hidden"></canvas>
      <button id="downloadBtn" class="hidden bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg">Download Image</button>
    </div>
  </div>
  <script>
    const makeBtn = document.getElementById('makeBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const canvas = document.getElementById('chart');
    let chart;

    makeBtn.addEventListener('click', () => {
      const lines = document.getElementById('data').value.trim().split('\n');
      const labels = [], values = [];
      lines.forEach(l => {
        const [label, val] = l.split(',').map(s => s.trim());
        if (label && val) { labels.push(label); values.push(Number(val)); }
      });
      if (!labels.length) return alert('Please enter data');
      if (chart) chart.destroy();
      canvas.classList.remove('hidden');
      chart = new Chart(canvas, {
        type: 'bar',
        data: { labels, datasets: [{ label: 'Value', data: values, backgroundColor: '#3b82f6' }] },
        options: { responsive: true, plugins: { legend: { display: false } } }
      });
      downloadBtn.classList.remove('hidden');
    });

    downloadBtn.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'chart.png';
      a.click();
    });
  </script>
</body>
</html>
