<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JSON Formatter - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Format, validate, and beautify JSON online. Free JSON tool.">
  <link rel="canonical" href="https://protoolnest.com/json-formatter"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">JSON Formatter</h1>
    <p class="text-gray-600 mb-6">Format and validate JSON.</p>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="input" rows="10" class="w-full border rounded-lg p-4 font-mono text-sm" placeholder='{"key": "value"}'></textarea>
      <div class="flex gap-2">
        <button id="format" class="bg-blue-600 text-white px-4 py-2 rounded-lg">Format</button>
        <button id="minify" class="bg-gray-600 text-white px-4 py-2 rounded-lg">Minify</button>
      </div>
      <textarea id="output" rows="10" class="w-full border rounded-lg p-4 font-mono text-sm bg-gray-50" readonly></textarea>
      <div id="error" class="text-red-600 text-sm"></div>
    </div>
  </div>
  <script>
    function process(minify = false) {
      try {
        const obj = JSON.parse(document.getElementById('input').value);
        document.getElementById('output').value = minify ? JSON.stringify(obj) : JSON.stringify(obj, null, 2);
        document.getElementById('error').textContent = '';
      } catch (e) {
        document.getElementById('error').textContent = 'Invalid JSON: ' + e.message;
      }
    }
    document.getElementById('format').onclick = () => process(false);
    document.getElementById('minify').onclick = () => process(true);
  </script>
</body>
</html>
