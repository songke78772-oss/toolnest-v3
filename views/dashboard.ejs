<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
<nav class="bg-white border-b px-4 py-3">
  <div class="max-w-5xl mx-auto flex justify-between">
    <a href="/" class="text-xl font-bold text-blue-600">ToolNest</a>
    <a href="/logout" class="text-sm text-gray-600">Logout</a>
  </div>
</nav>
<div class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Welcome, <%= user.email %></h1>
  <h2 class="text-lg font-semibold mb-4">My Favorites</h2>
  <% if (favorites.length === 0) { %>
    <p class="text-gray-500">No favorites yet. <a href="/" class="text-blue-600">Browse tools</a></p>
  <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% favorites.forEach(tool => { %>
        <a href="/tool/<%= tool.id %>" class="bg-white rounded-xl border p-4 hover:shadow-md block">
          <div class="text-2xl"><%= tool.icon %></div>
          <h3 class="font-semibold mt-2"><%= tool.name %></h3>
          <p class="text-sm text-gray-500"><%= tool.description || '' %></p>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
</body>
</html>
