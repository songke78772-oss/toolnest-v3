<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto p-4 md:p-6 flex flex-col md:flex-row gap-6">

    <!-- Left Sidebar -->
    <div class="w-full md:w-80 bg-white rounded-2xl shadow p-6">
      <div class="flex flex-col items-center">
        <div class="w-20 h-20 rounded-full bg-purple-500 flex items-center justify-center text-white text-3xl font-bold mb-4">
          <%= (user.email || 'U')[0].toUpperCase() %>
        </div>
        <div class="font-semibold text-lg text-center break-all"><%= user.email %></div>
        <div class="text-gray-500 text-sm text-center break-all mb-4"><%= user.email %></div>
        <button class="w-full border border-blue-500 text-blue-500 rounded-lg py-2 text-sm mb-6">Upload Photo</button>
      </div>

      <div class="border-t pt-4 space-y-3 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Name</span><span class="font-medium break-all"><%= user.email %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Email</span><span class="font-medium break-all"><%= user.email %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Current Plan</span><span class="font-medium">Free</span></div>
      </div>

      <div class="mt-6 flex gap-2">
        <button class="flex-1 text-yellow-500 text-sm py-2">Edit</button>
        <button class="flex-1 bg-red-500 text-white rounded-lg py-2 text-sm">Delete Account</button>
      </div>

      <a href="/logout" class="mt-4 block w-full bg-blue-500 text-white text-center rounded-lg py-3 font-medium">Logout</a>
    </div>

    <!-- Main Content -->
    <div class="flex-1 bg-white rounded-2xl shadow p-6">
      <h1 class="text-2xl font-bold mb-6">Account Settings</h1>

      <!-- Tabs -->
      <div class="flex border-b mb-6">
        <button onclick="showTab('billing')" id="tab-billing" class="px-4 py-2 border-b-2 border-blue-500 text-blue-600 font-medium">Billings</button>
        <button onclick="showTab('favorites')" id="tab-favorites" class="px-4 py-2 text-gray-500">Favourite Tools</button>
      </div>

      <!-- Billing Tab -->
      <div id="billing" class="tab-content">
        <h2 class="text-xl font-semibold mb-4">Billing Information</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <!-- Free Plan -->
          <div class="border rounded-xl p-4 bg-blue-500 text-white">
            <div class="font-bold">Free Plan</div>
            <div class="text-sm opacity-90 mb-3">Free tools for everyone</div>
            <div class="text-2xl font-bold mb-4">FREE</div>
            <button class="w-full bg-white/20 rounded-lg py-2 text-sm">Current Plan</button>
          </div>
          <!-- Paid Plans -->
          <div class="border rounded-xl p-4">
            <div class="font-bold">Pro Plan</div>
            <div class="text-sm text-gray-500 mb-3">Unlimited access to all tools</div>
            <div class="text-xl font-bold mb-4">$1.99<span class="text-sm font-normal text-gray-500">/month</span></div>
            <a href="/subscribe" class="block w-full bg-blue-500 text-white text-center rounded-lg py-2 text-sm">Upgrade Plan</a>
          </div>
          <div class="border rounded-xl p-4">
            <div class="font-bold">PDF Unlimited</div>
            <div class="text-sm text-gray-500 mb-3">Unlimited PDF tools</div>
            <div class="text-xl font-bold mb-4">$4.99<span class="text-sm font-normal text-gray-500">/month</span></div>
            <a href="/subscribe" class="block w-full bg-blue-500 text-white text-center rounded-lg py-2 text-sm">Upgrade Plan</a>
          </div>
          <div class="border rounded-xl p-4">
            <div class="font-bold">All Unlimited</div>
            <div class="text-sm text-gray-500 mb-3">Everything included</div>
            <div class="text-xl font-bold mb-4">$9.99<span class="text-sm font-normal text-gray-500">/month</span></div>
            <a href="/subscribe" class="block w-full bg-blue-500 text-white text-center rounded-lg py-2 text-sm">Upgrade Plan</a>
          </div>
        </div>

        <div class="border-t pt-6">
          <div class="text-center text-gray-400 text-sm mb-4">BILLING HISTORY</div>
          <div class="border rounded-xl overflow-hidden">
            <div class="grid grid-cols-4 bg-gray-100 text-sm font-medium px-4 py-3">
              <div>Invoice #</div><div>Amount</div><div>Date</div><div>Status</div>
            </div>
            <div class="px-4 py-8 text-center text-gray-500">You haven't made any payments</div>
          </div>
        </div>
      </div>

      <!-- Favorites Tab -->
      <div id="favorites" class="tab-content hidden">
        <h2 class="text-xl font-semibold mb-4">Favourite Tools</h2>
        <% if (!favorites || favorites.length === 0) { %>
          <p class="text-gray-500">No favorites yet. <a href="/" class="text-blue-600">Browse tools</a></p>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% favorites.forEach(tool => { %>
              <a href="/tool/<%= tool.id %>" class="border rounded-xl p-4 hover:shadow transition">
                <div class="font-semibold"><%= tool.name %></div>
                <div class="text-sm text-gray-500 mt-1"><%= tool.description || '' %></div>
                <div class="text-xs text-blue-500 mt-2"><%= tool.category || 'Tool' %></div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    function showTab(name) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(name).classList.remove('hidden');
      document.getElementById('tab-billing').className = 'px-4 py-2 text-gray-500';
      document.getElementById('tab-favorites').className = 'px-4 py-2 text-gray-500';
      document.getElementById('tab-' + name).className = 'px-4 py-2 border-b-2 border-blue-500 text-blue-600 font-medium';
    }
  </script>
</body>
</html>
