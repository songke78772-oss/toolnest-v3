<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Word Counter - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-3xl mx-auto p-4 md:p-8">
    <a href="/" class="text-blue-600 text-sm">← Back to tools</a>
    <h1 class="text-2xl font-bold mt-4 mb-6">Word Counter</h1>
    <textarea id="text" rows="12" placeholder="Paste or type your text..."
      class="w-full border rounded-xl p-4"></textarea>
    <div class="mt-4 grid grid-cols-3 gap-4 text-center">
      <div class="bg-white border rounded-xl p-4"><div class="text-2xl font-bold" id="words">0</div><div class="text-sm text-gray-500">Words</div></div>
      <div class="bg-white border rounded-xl p-4"><div class="text-2xl font-bold" id="chars">0</div><div class="text-sm text-gray-500">Characters</div></div>
      <div class="bg-white border rounded-xl p-4"><div class="text-2xl font-bold" id="charsNoSpace">0</div><div class="text-sm text-gray-500">No Spaces</div></div>
    </div>
  </div>
  <script>
    const textarea = document.getElementById('text');
    textarea.addEventListener('input', () => {
      const text = textarea.value;
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      document.getElementById('words').textContent = words;
      document.getElementById('chars').textContent = text.length;
      document.getElementById('charsNoSpace').textContent = text.replace(/\s/g, '').length;
    });
  </script>
</body>
</html>
