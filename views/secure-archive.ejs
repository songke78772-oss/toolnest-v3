<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure Archive - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <nav class="bg-white shadow-sm border-b">
    <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-blue-600">ToolNest</a>
      <a href="/" class="text-gray-600 hover:text-blue-600">← Back</a>
    </div>
  </nav>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-2">Secure Archive</h1>
    <p class="text-gray-600 mb-8">Encrypt any file locally in your browser. Nothing is uploaded. You get an encrypted file, a self-contained decryptor, and key shares.</p>

    <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
      <h2 class="font-bold text-lg mb-4">Encrypt a File</h2>

      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Select file</label>
        <input type="file" id="fileInput" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Total key shares</label>
          <input type="number" id="keyCount" value="3" min="2" class="border rounded px-3 py-2 w-full">
          <p class="text-xs text-gray-500 mt-1">Recommended: do not exceed 10 shares to reduce the risk of losing keys.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Minimum required</label>
          <input type="number" id="threshold" value="2" min="2" class="border rounded px-3 py-2 w-full">
          <p class="text-xs text-gray-500 mt-1">Any this many shares can decrypt</p>
        </div>
      </div>

      <button id="encryptBtn" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 disabled:opacity-50" disabled>
        Encrypt & Download
      </button>

      <div id="status" class="mt-4 text-sm text-gray-600"></div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <div class="border-b mb-4">
        <span class="text-blue-600 font-medium border-b-2 border-blue-600 pb-2">How to Use</span>
      </div>
      <div class="space-y-4 text-sm text-gray-600">
        <div>
          <strong class="text-gray-900">1. Set total shares and minimum required</strong><br>
          Example: 3 total shares, minimum 2. Any 2 of the 3 key files can decrypt.
        </div>
        <div>
          <strong class="text-gray-900">2. Encrypt & Download</strong><br>
          Downloads the encrypted file (.enc), a self-contained decryptor (decrypt.html), and the key share files (.key).
        </div>
        <div>
          <strong class="text-gray-900">3. Store them separately</strong><br>
          Keep .enc + decrypt.html together. Distribute the .key files to different people or places.
        </div>
        <div>
          <strong class="text-gray-900">4. Decrypt later</strong><br>
          Open decrypt.html, upload the .enc file and at least the minimum number of .key files.
        </div>
        <div class="text-red-600">
          <strong class="text-red-700">5. Important</strong><br>
          If fewer than the minimum number of key shares are available, the file cannot be recovered.
        </div>
      </div>
    </div>
  </div>

  <script>
  function gfMul(a, b) {
    let p = 0;
    for (let i = 0; i < 8; i++) {
      if (b & 1) p ^= a;
      const hi = a & 0x80;
      a = (a << 1) & 0xff;
      if (hi) a ^= 0x1b;
      b >>= 1;
    }
    return p;
  }

  function gfDiv(a, b) {
    if (b === 0) throw new Error('Division by zero');
    let inv = 1;
    for (let i = 1; i < 256; i++) {
      if (gfMul(b, i) === 1) { inv = i; break; }
    }
    return gfMul(a, inv);
  }

  function shamirSplit(secret, n, k) {
    const shares = Array.from({ length: n }, () => new Uint8Array(33));
    for (let byteIdx = 0; byteIdx < 32; byteIdx++) {
      const coeffs = [secret[byteIdx]];
      for (let i = 1; i < k; i++) {
        coeffs.push(crypto.getRandomValues(new Uint8Array(1))[0] || 1);
      }
      for (let x = 1; x <= n; x++) {
        let y = 0;
        for (let i = k - 1; i >= 0; i--) {
          y = gfMul(y, x) ^ coeffs[i];
        }
        shares[x - 1][0] = x;
        shares[x - 1][byteIdx + 1] = y;
      }
    }
    return shares;
  }

  function shamirCombine(shares) {
    const k = shares.length;
    const secret = new Uint8Array(32);
    for (let byteIdx = 0; byteIdx < 32; byteIdx++) {
      let result = 0;
      for (let i = 0; i < k; i++) {
        const xi = shares[i][0];
        const yi = shares[i][byteIdx + 1];
        let num = 1, den = 1;
        for (let j = 0; j < k; j++) {
          if (i === j) continue;
          const xj = shares[j][0];
          num = gfMul(num, xj);
          den = gfMul(den, xi ^ xj);
        }
        result ^= gfMul(yi, gfDiv(num, den));
      }
      secret[byteIdx] = result;
    }
    return secret;
  }

  const fileInput = document.getElementById('fileInput');
  const keyCountInput = document.getElementById('keyCount');
  const thresholdInput = document.getElementById('threshold');
  const encryptBtn = document.getElementById('encryptBtn');
  const statusDiv = document.getElementById('status');

  fileInput.addEventListener('change', () => {
    encryptBtn.disabled = !fileInput.files.length;
  });

  keyCountInput.addEventListener('change', () => {
    const n = parseInt(keyCountInput.value) || 2;
    if (parseInt(thresholdInput.value) > n) thresholdInput.value = n;
  });

  function downloadBlob(blob, filename) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  encryptBtn.addEventListener('click', async () => {
    const file = fileInput.files[0];
    if (!file) return;

    const n = Math.max(2, parseInt(keyCountInput.value) || 3);
    const k = Math.min(n, Math.max(2, parseInt(thresholdInput.value) || 2));

    statusDiv.textContent = 'Encrypting...';
    encryptBtn.disabled = true;

    try {
      const key = await crypto.subtle.generateKey(
        { name: 'AES-GCM', length: 256 },
        true,
        ['encrypt', 'decrypt']
      );

      const iv = crypto.getRandomValues(new Uint8Array(12));
      const fileBuffer = await file.arrayBuffer();
      const encrypted = await crypto.subtle.encrypt(
        { name: 'AES-GCM', iv },
        key,
        fileBuffer
      );

      const rawKey = new Uint8Array(await crypto.subtle.exportKey('raw', key));
      const shares = shamirSplit(rawKey, n, k);

      const baseName = file.name.replace(/\.[^/.]+$/, '') || 'file';

      downloadBlob(new Blob([iv, new Uint8Array(encrypted)]), baseName + '.enc');

      shares.forEach((share, idx) => {
        downloadBlob(new Blob([share]), baseName + '-key-' + (idx + 1) + '.key');
      });

      const decryptHtml = generateDecryptHtml(file.name, k);
      downloadBlob(new Blob([decryptHtml], { type: 'text/html' }), 'decrypt.html');

      statusDiv.textContent = `Done. Total ${n} shares, any ${k} can decrypt.`;
    } catch (err) {
      console.error(err);
      statusDiv.textContent = 'Encryption failed: ' + err.message;
    } finally {
      encryptBtn.disabled = false;
    }
  });

  function generateDecryptHtml(originalName, threshold) {
    return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Decrypt File</title>
<style>
body { font-family: system-ui, sans-serif; max-width: 600px; margin: 40px auto; padding: 20px; }
input, button { margin: 8px 0; padding: 8px; display: block; }
button { background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; }
#status { margin-top: 12px; color: #555; }
</style>
</head>
<body>
<h2>Decrypt File</h2>
<p>Upload the .enc file and at least ${threshold} key files.</p>
<input type="file" id="encFile" accept=".enc">
<input type="file" id="keyFiles" accept=".key" multiple>
<button id="decryptBtn">Decrypt</button>
<div id="status"></div>
<script>
function gfMul(a, b) {
  let p = 0;
  for (let i = 0; i < 8; i++) {
    if (b & 1) p ^= a;
    const hi = a & 0x80;
    a = (a << 1) & 0xff;
    if (hi) a ^= 0x1b;
    b >>= 1;
  }
  return p;
}
function gfDiv(a, b) {
  let inv = 1;
  for (let i = 1; i < 256; i++) {
    if (gfMul(b, i) === 1) { inv = i; break; }
  }
  return gfMul(a, inv);
}
function shamirCombine(shares) {
  const k = shares.length;
  const secret = new Uint8Array(32);
  for (let byteIdx = 0; byteIdx < 32; byteIdx++) {
    let result = 0;
    for (let i = 0; i < k; i++) {
      const xi = shares[i][0];
      const yi = shares[i][byteIdx + 1];
      let num = 1, den = 1;
      for (let j = 0; j < k; j++) {
        if (i === j) continue;
        const xj = shares[j][0];
        num = gfMul(num, xj);
        den = gfMul(den, xi ^ xj);
      }
      result ^= gfMul(yi, gfDiv(num, den));
    }
    secret[byteIdx] = result;
  }
  return secret;
}
document.getElementById('decryptBtn').onclick = async () => {
  const status = document.getElementById('status');
  const encFile = document.getElementById('encFile').files[0];
  const keyFiles = document.getElementById('keyFiles').files;
  if (!encFile || keyFiles.length < ${threshold}) {
    status.textContent = 'Need at least ${threshold} key files.';
    return;
  }
  status.textContent = 'Decrypting...';
  try {
    const encBuf = await encFile.arrayBuffer();
    const iv = new Uint8Array(encBuf.slice(0, 12));
    const ciphertext = encBuf.slice(12);
    const shares = [];
    for (const kf of keyFiles) {
      shares.push(new Uint8Array(await kf.arrayBuffer()));
    }
    const keyBytes = shamirCombine(shares.slice(0, ${threshold}));
    const key = await crypto.subtle.importKey('raw', keyBytes, 'AES-GCM', false, ['decrypt']);
    const decrypted = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ciphertext);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([decrypted]));
    a.download = ${JSON.stringify(originalName)};
    a.click();
    status.textContent = 'Decrypted successfully.';
  } catch (e) {
    status.textContent = 'Decryption failed. Check that you have enough valid key files.';
  }
};
<\/script>
</body>
</html>`;
  }
  </script>
</body>
</html>
