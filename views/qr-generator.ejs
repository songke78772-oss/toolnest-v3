<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code Generator - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

  <meta name="description" content="Generate QR codes from text or URLs. Free online QR code maker.">
  <link rel="canonical" href="https://protoolnest.com/qr-generator"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">QR Code Generator</h1>
    <p class="text-gray-600 mb-6">Generate QR codes from text or URLs.</p>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <textarea id="text" rows="4" class="w-full border rounded-lg p-4" placeholder="Enter text or URL...">https://example.com</textarea>
      <button id="generate" class="bg-blue-600 text-white px-6 py-2 rounded-lg">Generate</button>
      <div id="qrcode" class="flex justify-center p-4"></div>
      <button id="download" class="bg-gray-600 text-white px-4 py-2 rounded-lg">Download PNG</button>
      <div id="status" class="text-sm text-gray-500"></div>
    </div>
  </div>
  <script>
    document.getElementById('generate').onclick = function() {
      const text = document.getElementById('text').value.trim();
      const status = document.getElementById('status');
      const container = document.getElementById('qrcode');

      if (!text) {
        status.textContent = 'Please enter some text';
        return;
      }

      status.textContent = 'Generating...';
      container.innerHTML = '';

      try {
        new QRCode(container, {
          text: text,
          width: 256,
          height: 256,
          colorDark: "#000000",
          colorLight: "#ffffff",
          correctLevel: QRCode.CorrectLevel.H
        });
        status.textContent = 'Done';
      } catch (e) {
        status.textContent = 'Error: ' + e.message;
        console.error(e);
      }
    };

    document.getElementById('download').onclick = function() {
      const canvas = document.querySelector('#qrcode canvas');
      if (!canvas) {
        alert('Generate a QR code first');
        return;
      }
      const a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'qrcode.png';
      a.click();
    };
  </script>
</body>
</html>
