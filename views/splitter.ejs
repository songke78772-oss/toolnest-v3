<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Splitter - ProToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Free online splitter tool by ProToolNest.">
  <link rel="canonical" href="https://protoolnest.com/splitter"></head>
<body class="bg-gray-50">
  <nav class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-gray-800">ProToolNest</a>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-800">← Back to Tools</a>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Image Splitter</h1>
      <p class="text-gray-600 mt-2">Split image into grid pieces. All processing happens in your browser.</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <div id="uploadArea" class="border-2 border-dashed border-gray-300 rounded-lg p-10 text-center cursor-pointer hover:border-blue-500 transition">
        <div class="text-5xl mb-3">✂️</div>
        <p class="text-lg font-medium text-gray-700">Click or drag image here</p>
        <input type="file" id="fileInput" accept="image/*" class="hidden">
      </div>
      <div id="controls" class="hidden space-y-4">
        <div class="flex gap-4">
          <div>
            <label class="text-sm">Rows</label>
            <input type="number" id="rows" value="2" min="1" max="10" class="border rounded px-3 py-2 w-24">
          </div>
          <div>
            <label class="text-sm">Columns</label>
            <input type="number" id="cols" value="2" min="1" max="10" class="border rounded px-3 py-2 w-24">
          </div>
        </div>
        <button id="splitBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg">Split Image</button>
        <div id="pieces" class="grid gap-2 mt-4"></div>
      </div>
    </div>
  </div>
  <script>
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const controls = document.getElementById('controls');
    const splitBtn = document.getElementById('splitBtn');
    const pieces = document.getElementById('pieces');
    let originalFile;

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('drop', e => { e.preventDefault(); if (e.dataTransfer.files[0]) load(e.dataTransfer.files[0]); });
    uploadArea.addEventListener('dragover', e => e.preventDefault());
    fileInput.addEventListener('change', e => { if (e.target.files[0]) load(e.target.files[0]); });

    function load(file) {
      originalFile = file;
      controls.classList.remove('hidden');
    }

    splitBtn.addEventListener('click', () => {
      if (!originalFile) return;
      const rows = parseInt(document.getElementById('rows').value);
      const cols = parseInt(document.getElementById('cols').value);
      const img = new Image();
      img.onload = () => {
        pieces.innerHTML = '';
        pieces.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
        const w = Math.floor(img.width / cols);
        const h = Math.floor(img.height / rows);
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, c * w, r * h, w, h, 0, 0, w, h);
            const div = document.createElement('div');
            div.className = 'border';
            const im = document.createElement('img');
            im.src = canvas.toDataURL('image/jpeg', 0.9);
            im.className = 'w-full';
            const a = document.createElement('a');
            a.href = im.src;
            a.download = `piece_${r}_${c}.jpg`;
            a.textContent = 'Download';
            a.className = 'block text-center text-sm text-blue-600 py-1';
            div.appendChild(im);
            div.appendChild(a);
            pieces.appendChild(div);
          }
        }
      };
      img.src = URL.createObjectURL(originalFile);
    });
  </script>
</body>
</html>
